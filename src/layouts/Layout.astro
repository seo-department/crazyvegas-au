---
import MegaMenu from "../components/MegaMenu.astro"

interface Props {
    title: string
    description?: string
    seoTitle?: string
    schema?: string
    canonical?: string
    robots?: string
    keywords?: string
    author?: string
    image?: string
    ogType?: string
}

const {
    title,
    description = "Your trusted guide to the fastest online casinos in the USA.",
    seoTitle,
    schema,
    canonical,
    robots = "index, follow", // Default to indexing
    keywords,
    author,
    image = "/wp-content/uploads/2023/11/crazy-vegas-jester-logo-340x52.png",
    ogType = "website",
} = Astro.props

const finalTitle = seoTitle ? seoTitle : title

// Auto-generate a self-referencing canonical URL if Yoast doesn't provide a custom one
const canonicalURL = canonical || Astro.url.href

// Site identity + absolute OG image (works whether or not `site` is set in astro.config)
const siteName = "Crazy Vegas"
const baseForUrls = Astro.site ?? new URL(Astro.url.origin)
const ogImage = new URL(image, baseForUrls).href

const WP_HOSTS = [
    "https://wordpress-1164434-6467266.cloudwaysapps.com",
    "http://wordpress-1164434-6467266.cloudwaysapps.com", // present
    "https://www.wordpress-1164434-6467266.cloudwaysapps.com",
    "//wordpress-1164434-6467266.cloudwaysapps.com",
]
function stripWp(input = "") {
    let out = input
    for (const h of WP_HOSTS) out = out.split(h).join("")
    return out
}

const PUBLIC_HOST = "au.crazyvegas.com"
function swapWpHost(input = "") {
    if (!input) return input
    let out = input
    for (const h of [
        "https://www.wordpress-1164434-6467266.cloudwaysapps.com",
        "http://www.wordpress-1164434-6467266.cloudwaysapps.com",
        "https://wordpress-1164434-6467266.cloudwaysapps.com",
        "http://wordpress-1164434-6467266.cloudwaysapps.com",
        "//www.wordpress-1164434-6467266.cloudwaysapps.com",
        "//wordpress-1164434-6467266.cloudwaysapps.com",
    ]) {
        out = out.split(h).join("https://" + PUBLIC_HOST)
    }
    // 🚨 Catch bare-domain leaks (emails, etc.) with no protocol prefix
    out = out.replace(
        /([a-zA-Z0-9._%+-]+)@wordpress-1164434-6467266\.cloudwaysapps\.com/g,
        `contact@${PUBLIC_HOST}`
    )
    return out
}
// Shared WP GraphQL endpoint — declared once, before any block that fetches from it
const wpGraphQLEndpoint =
    "https://wordpress-1164434-6467266.cloudwaysapps.com/graphql"

// --- DYNAMIC FOOTER DATA FETCHING ---
// (wpGraphQLEndpoint is already declared above)

// Formats the Astro author prop into a safe WordPress slug (e.g., "Mason Heaton" -> "mason-heaton")
const authorSlug = author ? author.toLowerCase().replace(/\s+/g, "-") : "mason"

const query = `
  query FooterData($authorSlug: ID!) {
    user(id: $authorSlug, idType: SLUG) {
      name
      description
      avatar {
        url
      }
      uri
    }
    posts(first: 3) {
      nodes {
        title
        uri
        date
        featuredImage {
          node {
            sourceUrl
            altText
          }
        }
      }
    }
  }
`

// Dynamic Fallback Logic based on the author prop
const fallbackName = author || "Mason Heaton"
let wpAuthor = {
    name: fallbackName,
    description: `Casino Expert and reviewer, ${fallbackName} brings years of industry experience to help players find the best and safest online casinos.`,
    avatar: {
        url: `https://ui-avatars.com/api/?name=${encodeURIComponent(fallbackName)}&background=f1f5f9&color=1e293b&bold=true`,
    },
    uri: `/about-us/${authorSlug}/`,
}

// Hardcoded fallback for Mason if no specific author is passed or WP fails
if (fallbackName === "Mason Heaton" || fallbackName === "Editorial Team") {
    wpAuthor.name = "Mason Heaton"
    wpAuthor.description =
        "Mason Heaton is a seasoned iGaming specialist and digital publishing strategist with more than a decade of hands-on experience covering online casinos, gambling legislation, responsible gaming practices, and the ever-evolving betting landscape."
    wpAuthor.avatar.url = "/wp-content/uploads/2026/03/mason-j.png"
}

let latestPosts = []

try {
    const response = await fetch(wpGraphQLEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query, variables: { authorSlug } }),
    })
    const { data } = await response.json()

    if (data?.posts?.nodes) {
        latestPosts = data.posts.nodes
    }

    // If WP finds the user, merge the real data with the fallbacks
    if (data?.user) {
        wpAuthor = {
            name: data.user.name || wpAuthor.name,
            description: data.user.description || wpAuthor.description,
            avatar: { url: data.user.avatar?.url || wpAuthor.avatar.url },
            uri: data.user.uri || wpAuthor.uri,
        }
    }
} catch (error) {
    console.error("Error fetching WP GraphQL data for footer:", error)
}

// Manually pin Kyla's footer avatar only (overrides any WP/Gravatar avatar)
const isKyla = [author, wpAuthor.name]
    .filter(Boolean)
    .some(n => /ka?yla|mcbrien/i.test(n))

if (isKyla) {
    wpAuthor.avatar.url = "/wp-content/uploads/2026/03/kayla-mcbrien.png"
}

// Helper function to format the post date as "X months ago"
function timeAgo(dateString: string) {
    const date = new Date(dateString)
    const now = new Date()
    const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1000)
    const diffInDays = Math.floor(diffInSeconds / 86400)

    if (diffInDays === 0) return "Today"
    if (diffInDays === 1) return "1 day ago"
    if (diffInDays < 30) return `${diffInDays} days ago`

    const diffInMonths = Math.floor(diffInDays / 30)
    if (diffInMonths === 1) return "1 month ago"
    if (diffInMonths < 12) return `${diffInMonths} months ago`

    const diffInYears = Math.floor(diffInMonths / 12)
    return diffInYears === 1 ? "1 year ago" : `${diffInYears} years ago`
}
