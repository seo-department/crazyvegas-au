<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Find all strong tags inside your lists
        const listStrongTags = document.querySelectorAll(
            ".cus-page-container ul li strong",
        )

        listStrongTags.forEach(function (tag) {
            // Get the text inside the tag and clean up any accidental spaces/line breaks
            const textContent = tag.textContent.trim()

            // CONDITION: Does the text end with a question mark?
            if (textContent.endsWith("?")) {
                // If yes, add a special class to format it as a question
                tag.classList.add("faq-question-block")

                // Optional: If there is a <br> tag right after the question, we can hide it so the spacing is perfectly controlled by CSS
                const nextElement = tag.nextElementSibling
                if (nextElement && nextElement.tagName === "BR") {
                    nextElement.style.display = "none"
                }
            }
        })
    })
</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // 1. Automatically Inject Checkboxes into every Casino Card
        const cards = document.querySelectorAll(".cus-casino-card")
        cards.forEach((card, index) => {
            // Target the logo column instead of the whole card body
            const logoCol = card.querySelector(".cus-col-logo")

            if (logoCol) {
                const label = document.createElement("label")
                label.className = "cus-compare-label"
                label.innerHTML = `<input type="checkbox" class="cus-compare-cb" value="${index}"> Compare`

                // Append it to the bottom of the logo column (under 'More Information')
                logoCol.appendChild(label)
            }
        })

        // 2. Build and inject the Hidden Modal into the page
        const modalHTML = `
        <div class="compare-modal-backdrop" id="compare-modal">
            <div class="compare-modal-content">
                <button class="compare-close-btn" id="compare-close"><i class="fa-solid fa-xmark"></i></button>
                <div class="compare-header">
                    <h2>Casino Head-to-Head</h2>
                </div>
                <div class="compare-grid" id="compare-grid-content">
                    </div>
            </div>
        </div>
    `
        document.body.insertAdjacentHTML("beforeend", modalHTML)

        // 3. State & DOM References
        let selectedCasinos = []
        const modal = document.getElementById("compare-modal")
        const closeBtn = document.getElementById("compare-close")
        const gridContent = document.getElementById("compare-grid-content")

        // 4. Handle Checkbox Clicks
        document.body.addEventListener("change", e => {
            if (e.target.classList.contains("cus-compare-cb")) {
                const checkbox = e.target
                const label = checkbox.parentElement
                const card = checkbox.closest(".cus-casino-card")

                if (checkbox.checked) {
                    // If they already have 2 selected, block a 3rd selection
                    if (selectedCasinos.length >= 2) {
                        checkbox.checked = false
                        alert("You can only compare 2 casinos at a time.")
                        return
                    }

                    label.classList.add("checked")
                    selectedCasinos.push(card)

                    // If exactly 2 are now selected, trigger the modal!
                    if (selectedCasinos.length === 2) {
                        buildAndShowModal()
                    }
                } else {
                    // Unchecked
                    label.classList.remove("checked")
                    selectedCasinos = selectedCasinos.filter(c => c !== card)
                }
            }
        })

        // 5. Build Modal Content based on the 2 selected cards
        function buildAndShowModal() {
            let html = '<div class="compare-vs-badge">VS</div>'

            selectedCasinos.forEach(card => {
                // Safely scrape data from the WordPress HTML card
                const logoSrc =
                    card.querySelector(".cus-logo-box img")?.src || ""
                const name =
                    card.querySelector(".cus-casino-name")?.innerText ||
                    "Casino"
                const rating =
                    card.querySelector(".cus-rating")?.innerText.trim() || "N/A"
                const bonus =
                    card.querySelector(".cus-bonus-title")?.innerText ||
                    "No Bonus listed"

                // Extracting stats (Payout time & Limits)
                const stats = card.querySelectorAll(".cus-stat-value")
                const payoutTime = stats[0]?.innerText || "N/A"
                const limit = stats[1]?.innerText || "N/A"

                const claimLink =
                    card.querySelector(".cus-claim-btn")?.href || "#"

                // Build Column
                html += `
                <div class="compare-col">
                    <img src="${logoSrc}" class="comp-logo" alt="${name}" referrerpolicy="no-referrer">
                    <div class="comp-name">${name}</div>
                    <div class="comp-rating"><i class="fa-solid fa-star"></i> <span>${rating}</span></div>
                    
                    <div class="comp-section comp-bonus">
                        <span class="comp-label" style="color: #15803d;">Welcome Bonus</span>
                        <div class="comp-value">${bonus}</div>
                    </div>

                    <div class="comp-section">
                        <span class="comp-label">Payout Speed</span>
                        <div class="comp-value">${payoutTime}</div>
                    </div>

                    <div class="comp-section">
                        <span class="comp-label">Withdrawal Limit</span>
                        <div class="comp-value">${limit}</div>
                    </div>

                    <a href="${claimLink}" class="cus-claim-btn" style="width: 100%; margin-top: auto;" target="_blank" rel="nofollow">
                        <i class="fa-regular fa-circle-check"></i> CLAIM BONUS
                    </a>
                </div>
            `
            })

            gridContent.innerHTML = html
            modal.classList.add("show")
        }

        // 6. Close Modal & Reset
        function closeModal() {
            modal.classList.remove("show")

            // Uncheck boxes and clear array so user can pick new ones
            selectedCasinos = []
            document.querySelectorAll(".cus-compare-cb").forEach(cb => {
                cb.checked = false
                cb.parentElement.classList.remove("checked")
            })
        }

        closeBtn.addEventListener("click", closeModal)
        modal.addEventListener("click", e => {
            if (e.target === modal) closeModal() // Close if clicking the dark background
        })
    })
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggleBtn = document.getElementById("myBtn")
        const collapseDiv = document.getElementById("demo")

        if (toggleBtn && collapseDiv) {
            toggleBtn.addEventListener("click", function (e) {
                e.preventDefault()

                // Check current state based on aria-expanded or inline heights
                const isExpanded =
                    toggleBtn.getAttribute("aria-expanded") === "true"

                if (!isExpanded) {
                    // EXPAND
                    collapseDiv.style.display = "block" // Ensure table structure renders
                    const fullHeight = collapseDiv.scrollHeight + "px"
                    collapseDiv.style.height = fullHeight

                    // Update state attributes
                    toggleBtn.setAttribute("aria-expanded", "true")
                    toggleBtn.classList.remove("collapsed")
                    collapseDiv.setAttribute("aria-expanded", "true")
                    collapseDiv.classList.remove("collapse")
                    collapseDiv.classList.add("collapsing")

                    // Update button text
                    toggleBtn.textContent = "Show Less"

                    setTimeout(() => {
                        collapseDiv.classList.remove("collapsing")
                        collapseDiv.style.height = "auto" // Allow responsive resizing
                    }, 400) // Matches CSS transition duration
                } else {
                    // COLLAPSE
                    // Explicitly set height back to pixels first instead of 'auto' for transition to work
                    collapseDiv.style.height = collapseDiv.scrollHeight + "px"

                    // Force a reflow
                    collapseDiv.offsetHeight

                    collapseDiv.style.height = "0px"
                    toggleBtn.setAttribute("aria-expanded", "false")
                    toggleBtn.classList.add("collapsed")
                    collapseDiv.setAttribute("aria-expanded", "false")
                    collapseDiv.classList.add("collapsing")

                    // Update button text
                    toggleBtn.textContent = "More Online Casinos"

                    setTimeout(() => {
                        collapseDiv.classList.remove("collapsing")
                        collapseDiv.classList.add("collapse")
                        collapseDiv.style.display = "none"
                    }, 400)

                    // Optional: Smoothly scroll view back to the top table if it jumped down too far
                    const tableContainer = document.querySelector(
                        ".space-organizations-3-archive-items",
                    )
                    if (tableContainer) {
                        tableContainer.scrollIntoView({
                            behavior: "smooth",
                            block: "end",
                        })
                    }
                }
            })
        }
    })
</script>

<script>
    // Back to top
    function initScrollTop() {
        const btn = document.getElementById("scroll-top-btn")
        if (!btn || btn.dataset.bound === "true") return
        btn.dataset.bound = "true"

        const toggle = () => {
            if (window.scrollY > 400) btn.classList.add("visible")
            else btn.classList.remove("visible")
        }
        window.addEventListener("scroll", toggle, { passive: true })
        toggle()

        btn.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" })
        })
    }
    document.addEventListener("DOMContentLoaded", initScrollTop)
    document.addEventListener("astro:page-load", initScrollTop)
</script>

<script>
    // Cookie consent
    function initCookieConsent() {
        const banner = document.getElementById("cookie-consent")
        if (!banner || banner.dataset.bound === "true") return
        banner.dataset.bound = "true"

        const accept = document.getElementById("cookie-accept")
        const decline = document.getElementById("cookie-decline")

        // Already chosen? Stay hidden.
        let choice = null
        try {
            choice = localStorage.getItem("cookie_consent")
        } catch (e) {}

        if (!choice) {
            // Small delay so it slides in after the page settles
            setTimeout(() => banner.classList.add("visible"), 600)
        }

        const close = value => {
            try {
                localStorage.setItem("cookie_consent", value)
            } catch (e) {}
            banner.classList.remove("visible")
        }

        if (accept) accept.addEventListener("click", () => close("accepted"))
        if (decline) decline.addEventListener("click", () => close("declined"))
    }
    document.addEventListener("DOMContentLoaded", initCookieConsent)
    document.addEventListener("astro:page-load", initCookieConsent)
</script>
