    .space-organization-float-bar {
        pointer-events: auto;
        display: flex;
        align-items: stretch;
        gap: 14px;
        padding: 12px 14px 12px 16px;
        border-radius: 18px;
        background: linear-gradient(
            135deg,
            rgba(28, 30, 46, 0.92),
            rgba(16, 18, 30, 0.92)
        );
        backdrop-filter: blur(18px) saturate(140%);
        -webkit-backdrop-filter: blur(18px) saturate(140%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow:
            0 1px 0 rgba(255, 255, 255, 0.05) inset,
            0 20px 50px -12px rgba(0, 0, 0, 0.7),
            0 0 0 1px rgba(245, 196, 81, 0.04);
        animation: floatbar-rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    @keyframes floatbar-rise {
        from {
            opacity: 0;
            transform: translateY(26px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ---- left: data block ---- */
    .space-organization-float-bar-data {
        flex: 1 1 auto;
        min-width: 0;
        display: flex;
        align-items: center;
    }
    .space-organization-float-bar-data-ins {
