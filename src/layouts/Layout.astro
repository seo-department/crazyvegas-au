    /* --- The Arrow --- */
    .toc-arrow {
        font-size: 12px;
        color: #64748b;
        transition: transform 0.3s ease; /* Smooth rotation */
    }

    /* --- Hidden Body Area --- */
    .toc-body {
        display: none; /* STRICTLY HIDDEN BY DEFAULT */
        padding: 20px;
        border-top: 1px solid #e2e8f0;
        max-height: 400px; /* Prevents massive TOCs from taking over the screen */
        overflow-y: auto; /* Adds a scrollbar if the list is too long */
    }

    /* --- List & Links Styling --- */
    .toc-body ul {
        list-style: none; /* Removes messy default bullets */
        margin: 0;
        padding: 0;
    }

    .toc-body li {
        margin-bottom: 12px;
        position: relative;
        padding-left: 16px;
    }

    /* Custom modern bullet point */
    .toc-body li::before {
        content: "•";
        color: #3b82f6;
        position: absolute;
        left: 0;
        font-weight: bold;
    }

    .toc-body li:last-child {
        margin-bottom: 0;
    }

    .toc-body a {
        color: #475569;
        text-decoration: none;
        font-size: 14.5px;
        font-weight: 500;
        transition:
            color 0.2s ease,
            transform 0.2s ease;
        display: inline-block;
    }

    /* Subtle nudge to the right on hover */
    .toc-body a:hover {
        color: #2563eb;
        text-decoration: underline;
        transform: translateX(4px);
    }

    /* --- Active/Open States (Triggered by JS) --- */
    .toc-wrapper.is-open .toc-body {
        display: block; /* Unhides the list */
    }

    .toc-wrapper.is-open .toc-arrow {
        transform: rotate(180deg); /* Flips the arrow upside down */
    }

