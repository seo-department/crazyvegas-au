    /* 5. Disclosure Badge Wrapper */
    .btn_with_tooltip {
        position: relative;
        cursor: help; /* Changes cursor to indicate a tooltip */
    }

    /* 6. Disclosure Badge (Button) */
    .btn_with_tooltip__btn {
        background-color: #f1f5f9;
        color: #475569;
        font-size: 13px;
        font-weight: 500;
        padding: 6px 14px;
        border-radius: 20px; /* Pill shape */
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }

    .btn_with_tooltip:hover .btn_with_tooltip__btn {
        background-color: #e2e8f0;
        color: #0f172a;
    }

    /* 7. Hover Tooltip Window */
    .btn_with_tooltip__tip {
        position: absolute;
        bottom: calc(100% + 12px);
        right: 0; /* Anchors to the right side so it doesn't break page width */
        width: 280px;
        background-color: #0f172a; /* Dark mode style tooltip */
        color: #f8fafc;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 12px;
        line-height: 1.5;
        box-shadow:
            0 10px 15px -3px rgba(0, 0, 0, 0.1),
            0 4px 6px -4px rgba(0, 0, 0, 0.1);

        /* Initial hidden state */
        opacity: 0;
        visibility: hidden;
        transform: translateY(8px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 50;
        pointer-events: none;
    }

    /* Tooltip Downward Arrow */
    .btn_with_tooltip__tip::after {
        content: "";
        position: absolute;
        top: 100%;
        right: 20px; /* Matches the right-anchored alignment */
        border-width: 6px;
        border-style: solid;
        border-color: #0f172a transparent transparent transparent;
    }

    /* Reveal Tooltip on Hover */
    .btn_with_tooltip:hover .btn_with_tooltip__tip {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    @media (min-width: 768px) {
        .content-wide--single-pages__post-author:first-child::after {
            content: "";
            display: block;
            width: 1px;
            height: 40px;
            background-color: #e2e8f0;
            margin-left: 20px; /* Adjust based on your preferred spacing */
        }
    }

