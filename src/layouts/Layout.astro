        --news-ink: #0f172a;
        --news-text: #334155;
        --news-muted: #64748b;
        --news-accent: #16a34a;
        --news-line: #e6eaf0;
        --news-card: #ffffff;
        --news-radius: 14px;
        --news-shadow:
            0 1px 2px rgba(15, 23, 42, 0.04),
            0 10px 26px -16px rgba(15, 23, 42, 0.18);
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
    }

    .space-posts-shortcode-1 .space-shortcode-wrap-ins {
        width: 100%;
    }

    /* Items wrapper -> responsive grid (kills the old floats) */
    .space-posts-shortcode-1 .space-news-1-items {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
        width: 100%;
        float: none;
    }

    /* Each card — neutralise box-25 / left floats */
    .space-posts-shortcode-1 .space-news-1-item {
        width: auto !important;
        float: none !important;
        margin: 0 !important;
        padding: 0;
    }

    .space-posts-shortcode-1 .space-news-1-item-ins {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        height: 100%;
        background: var(--news-card);
        border: 1px solid var(--news-line);
        border-radius: var(--news-radius);
        box-shadow: var(--news-shadow);
        padding: 0.75rem;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;
    }
    .space-posts-shortcode-1 .space-news-1-item-ins:hover {
        transform: translateY(-3px);
        border-color: #bbf7d0;
        box-shadow: 0 14px 30px -16px rgba(15, 23, 42, 0.28);
    }

    /* Thumbnail */
    .space-posts-shortcode-1 .space-news-1-item-img {
        float: none !important;
        flex: 0 0 auto;
        width: 72px;
        height: 72px;
    }
    .space-posts-shortcode-1 .space-news-1-item-img a,
    .space-posts-shortcode-1 .space-news-1-item-img img {
        display: block;
        width: 72px;
        height: 72px;
    }
    .space-posts-shortcode-1 .space-news-1-item-img img {
        object-fit: cover;
        border-radius: 10px;
        background: #f1f5f9;
    }
    /* Hide the thumbnail box when a post has no image */
    .space-posts-shortcode-1 .space-news-1-item-img:not(:has(img)) {
        display: none;
    }

    /* Text column */
    .space-posts-shortcode-1 .space-news-1-item-title-box {
        float: none !important;
        flex: 1 1 auto;
        min-width: 0;
    }

    /* Title — clamp to 3 lines */
    .space-posts-shortcode-1 .space-news-1-item-title {
        margin: 0 0 0.4rem;
    }
    .space-posts-shortcode-1 .space-news-1-item-title a {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-decoration: none;
        color: var(--news-ink);
        font-size: 0.92rem;
        font-weight: 600;
        line-height: 1.35;
        transition: color 0.15s ease;
    }
    .space-posts-shortcode-1 .space-news-1-item-title a:hover {
        color: var(--news-accent);
    }

    .cus-more-info-btn {
        color: #143c54 !important;
        font-weight: 600 !important;
    }

    /* Meta (clock + time-ago) */
    .space-posts-shortcode-1 .space-news-1-item-meta {
        font-size: 0.78rem;
        color: var(--news-muted);
    }
    .space-posts-shortcode-1 .space-news-1-item-meta span {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }
    .space-posts-shortcode-1 .space-news-1-item-meta i {
        color: var(--news-accent);
        font-size: 0.72rem;
    }

