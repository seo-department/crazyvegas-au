        font-size: 0.72rem;
    }

    /* ---- right: CTA ---- */
    .space-organization-float-bar-button {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }
    .space-organization-float-bar-button-all,
    .space-organization-float-bar-button-ins,
    .space-organization-float-bar-button-wrap {
        display: flex;
        width: 100%;
        height: 100%;
    }
    .space-organization-float-bar-button-wrap a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        white-space: nowrap;
        padding: 0 28px;
        height: 100%;
        min-height: 52px;
        border-radius: 13px;
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: 0.01em;
        text-decoration: none;
        color: var(--ink);
        background: linear-gradient(180deg, #ffd66b, var(--gold-deep));
        box-shadow:
            0 8px 20px -6px rgba(245, 196, 81, 0.55),
            0 1px 0 rgba(255, 255, 255, 0.5) inset;
        transition:
            transform 0.18s ease,
            box-shadow 0.25s ease,
            filter 0.2s ease;
        position: relative;
        overflow: hidden;
    }
    .space-organization-float-bar-button-wrap a::after {
        content: "\f061";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        font-size: 0.78rem;
        opacity: 0;
        margin-left: -6px;
        transition:
            opacity 0.2s ease,
            margin 0.2s ease;
    }
    .space-organization-float-bar-button-wrap a:hover {
        transform: translateY(-2px);
        filter: brightness(1.04);
        box-shadow:
            0 14px 28px -8px rgba(245, 196, 81, 0.7),
            0 1px 0 rgba(255, 255, 255, 0.5) inset;
    }
    .space-organization-float-bar-button-wrap a:hover::after {
        opacity: 1;
        margin-left: 2px;
    }
    .space-organization-float-bar-button-wrap a:active {
        transform: translateY(0);
    }

    /* shimmer sweep */
    .space-organization-float-bar-button-wrap a::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            115deg,
            transparent 30%,
            rgba(255, 255, 255, 0.45) 50%,
            transparent 70%
        );
        transform: translateX(-120%);
    }
    .space-organization-float-bar-button-wrap a:hover::before {
        animation: shine 0.8s ease;
    }
    @keyframes shine {
        to {
            transform: translateX(120%);
        }
    }

    /* ---- responsive ---- */
    @media (max-width: 680px) {
