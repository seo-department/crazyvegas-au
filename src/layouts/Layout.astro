    /* Table Base & Structure */
    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
        margin: 32px 0;
        border-radius: 12px;
        overflow: hidden; /* Ensures the rounded corners apply to the whole table */
        box-shadow:
            0 4px 6px -1px rgba(0, 0, 0, 0.05),
            0 2px 4px -2px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
    }

    /* Header Row (Dark Blue) */
    table thead {
        background-color: #0f172a; /* Slate 900 */
    }

    table thead tr {
        color: #ffffff;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: 0.5px;
    }

    table thead td,
    table thead th {
        padding: 16px 20px;
        font-weight: 700;
        text-align: left;
        border-bottom: none;
    }

    table thead td strong,
    table thead th strong {
        color: inherit;
    }

    /* Body Rows */
    table tbody {
        background-color: #ffffff;
    }

    table tbody tr {
        transition: background-color 0.2s ease;
    }

    /* Hover effect on rows */
    table tbody tr:hover {
        background-color: #f8fafc;
    }

    table tbody td {
        padding: 16px 20px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        font-size: 14px;
        vertical-align: middle;
    }

    /* Remove bottom border from the last row */
    table tbody tr:last-child td {
        border-bottom: none;
    }

    /* Target the first column (Methods) to make them bold */
    table tbody td:first-child {
        font-weight: 700;
        color: #0f172a;
    }

    /* Mobile Responsiveness */
    @media (max-width: 768px) {
        table {
            display: block;
            overflow-x: auto;
            white-space: nowrap;
        }
    }

    /* Header/Title styling */
    .toc_title {
        margin: 0 !important; /* This forces the invisible gap to disappear */
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 600;
        font-size: 16px;
        color: #0f172a;
        cursor: pointer;
        user-select: none;
    }

    /* CSS-only Chevron Arrow (No HTML added) */
    .toc_title::after {
        content: "";
        width: 8px;
        height: 8px;
        border-right: 2px solid #64748b;
        border-bottom: 2px solid #64748b;
        transform: translateY(-2px) rotate(45deg);
        transition: transform 0.3s ease;
        margin-right: 4px;
    }

    /* List container - Hidden by default using max-height for smooth animation */
    .toc_list {
        list-style: none;
        padding: 0;
        margin: 0;
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: all 0.3s ease-out;
    }

    /* 
 * OPEN STATE (Triggered by JS class) 
 */
    #toc_container.is-open .toc_list {
