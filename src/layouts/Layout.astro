    }
    .space-organization-float-bar-logo-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* ---- title + rating ---- */
    .space-organization-float-bar-title {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .space-organization-float-bar-title-wrap {
        font-weight: 700;
        font-size: 1.18rem;
        line-height: 1.15;
        color: #fff;
        letter-spacing: -0.01em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .space-organization-float-bar-rating {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .star-rating {
        display: inline-flex;
        gap: 3px;
    }
    .star {
        width: 16px;
        height: 16px;
        -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 .587l3.668 7.431 8.2 1.192-5.934 5.784 1.401 8.168L12 18.896l-7.335 3.866 1.401-8.168L.132 9.21l8.2-1.192z'/></svg>")
            center/contain no-repeat;
        mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 .587l3.668 7.431 8.2 1.192-5.934 5.784 1.401 8.168L12 18.896l-7.335 3.866 1.401-8.168L.132 9.21l8.2-1.192z'/></svg>")
            center/contain no-repeat;
        background: #3a3d4f;
    }
    .star-full {
        background: linear-gradient(180deg, var(--gold), var(--gold-deep));
    }
    .star-half {
        background: linear-gradient(90deg, var(--gold) 50%, #3a3d4f 50%);
    }
    .space-organization-float-bar-rating span {
        font-size: 0.82rem;
        font-weight: 600;
