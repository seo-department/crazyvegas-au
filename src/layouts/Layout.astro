    /* Container positioning */
    .modern-disclaimer-wrapper {
        position: relative;
        display: inline-flex;
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
    }

    /* Icon and Label Styling */
    .info-trigger {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #64748b; /* Slate gray */
        cursor: default;
        transition: color 0.2s ease;
        font-weight: 500;
        font-size: 14px;
    }

    .modern-disclaimer-wrapper:hover .info-trigger {
        color: #0f172a; /* Darker gray on hover */
    }

    /* Popover Card Styling */
    .disclaimer-popover {
        position: absolute;
        top: calc(100% + 12px); /* Positions the card just below the icon */
        left: 0;
        width: 350px; /* Constrains the text so it doesn't span the whole page */
        background-color: #ffffff;
        padding: 20px;
        border-radius: 12px;
        box-shadow:
            0 10px 25px -5px rgba(0, 0, 0, 0.1),
            0 8px 10px -6px rgba(0, 0, 0, 0.1);
        border: 1px solid #e2e8f0;
        z-index: 50;
        pointer-events: none; /* Prevents card from disappearing when moving mouse into it */

        /* Initial hidden state */
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Reveal the card on hover */
    .modern-disclaimer-wrapper:hover .disclaimer-popover {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        pointer-events: auto; /* Allows users to click the links inside */
    }

    /* Typography & Links */
    .disclaimer-popover p {
        margin: 0 0 12px 0;
        font-size: 13px;
        line-height: 1.6;
        color: #334155;
    }

    .disclaimer-popover p:last-child {
        margin-bottom: 0;
    }

    .disclaimer-popover a {
        color: #2563eb; /* Modern blue */
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }

    .disclaimer-popover a:hover {
        color: #1d4ed8;
        text-decoration: underline;
    }

    .btn_with_tooltip.disclaimer {
        display: none;
    }

    /* Base Container styling */
    #toc_container {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 2px 16px; /* Reduced from 16px to 12px for top and bottom */
