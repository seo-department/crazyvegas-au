        align-items: center;
        width: 100%;
        background: none;
        border: none;
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f172a;
        cursor: pointer;
        padding: 0;
        font-family: inherit;
    }

    .toc-icon {
        transition: transform 0.3s ease;
        color: #64748b;
    }

    /* ----------------------------------------------------
   1. TABLE RESET & WRAPPER
---------------------------------------------------- */
    .offers {
        width: 100%;
        border-collapse: collapse;
        display: flex;
        flex-direction: column;
        gap: 24px; /* Space between each card */
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
    }

    /* Hide the table headers. Modern card UIs are self-explanatory 
   and look much cleaner without rigid column headers. */
    .offers thead {
        display: none;
    }

    .offers tbody {
        display: flex;
        flex-direction: column;
        gap: 24px;
        width: 100%;
        counter-reset: casino-rank; /* Prepares our automatic numbering system */
    }

    /* Override rigid table cell behaviors */
    .offers td {
        display: block;
        padding: 0;
        border: none;
    }

    /* ----------------------------------------------------
   2. THE CARD (Desktop Layout)
---------------------------------------------------- */
    .offers tr.card {
        position: relative;
        counter-increment: casino-rank;

        /* The Grid Magic: Maps the 5 HTML columns into a sleek layout */
        display: grid;
        grid-template-columns: 200px 1fr 140px 220px;
        grid-template-areas:
            "logo bonus rating play"
            "logo desc desc play";
        gap: 16px;
        align-items: center;

        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .offers tr.card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.1);
        border-color: #cbd5e1;
    }

    table.offers {
        border: unset;
        box-shadow: unset;
    }

    /* --- MODERN MINI CASINO CARDS (Layout 4) --- */

    /* 1. Setup the Responsive Grid */
    .space-organizations-4-archive-items {
        display: grid !important;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin: 32px 0;
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
    }

    /* Strip legacy floats */
    .space-organizations-4-archive-items .box-25,
    .space-organizations-4-archive-items .box-50,
    .space-organizations-4-archive-items .box-100 {
        width: auto !important;
        float: none !important;
        margin: 0 !important;
    }

    /* 2. The Card Container */
    .space-organizations-4-archive-item-ins {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        height: 100%;
        box-sizing: border-box;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;
    }

    .space-organizations-4-archive-item-ins:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.1);
        border-color: #cbd5e1;
    }

    /* 3. Top Header (Logo + Title/Stars) */
    .space-organizations-4-archive-item-top {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f1f5f9;
    }

    /* Logo styling */
    .space-organizations-4-archive-item-logo img {
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        width: 50px;
        height: 50px;
        object-fit: contain;
        display: block;
    }

    /* Title styling */
    .space-organizations-4-archive-item-title {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .space-organizations-4-archive-item-title a {
        font-weight: 800;
        font-size: 15px;
        color: #0f172a;
        text-decoration: none;
        line-height: 1.2;
        transition: color 0.2s ease;
    }

    .space-organizations-4-archive-item-title a:hover {
        color: #0ea5e9;
    }

    /* Stars cleanup */
    .star-rating {
        display: flex;
        gap: 2px;
        color: #facc15; /* Vibrant gold for stars */
        font-size: 12px;
    }

    /* 4. The Bonus Description Badge */
    .space-organizations-4-archive-item-desc {
        background: #f0fdf4; /* Very light green */
        border: 1px dashed #bbf7d0;
        color: #15803d; /* Dark green text */
        font-weight: 800;
        font-size: 14px;
        text-align: center;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        flex-grow: 1; /* Pushes the buttons to the bottom of the card if text is short */
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* 5. The Buttons Container */
    .space-organizations-4-archive-item-buttons {
        display: flex;
        gap: 10px;
        margin-bottom: 12px;
    }

    .space-organizations-4-archive-item-button-one,
    .space-organizations-4-archive-item-button-two {
        flex: 1; /* Makes buttons equal width */
    }

    .space-organizations-4-archive-item-buttons a {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px 8px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        text-transform: uppercase;
        transition: all 0.2s ease;
        height: 100%;
        box-sizing: border-box;
    }

    /* Secondary Button (Read Review) */
    .space-organizations-4-archive-item-button-one-ins a {
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .space-organizations-4-archive-item-button-one-ins a:hover {
        background: #e2e8f0;
        color: #0f172a;
    }

    /* Primary Button (Get Bonus) */
    .space-organizations-4-archive-item-button-two-ins a {
        background: linear-gradient(135deg, #0ea5e9, #0284c7);
        color: #ffffff;
        border: 1px solid transparent;
        box-shadow: 0 4px 10px rgba(14, 165, 233, 0.3);
    }

    .space-organizations-4-archive-item-button-two-ins a:hover {
        background: linear-gradient(135deg, #0284c7, #0369a1);
        box-shadow: 0 6px 15px rgba(14, 165, 233, 0.4);
        transform: translateY(-2px);
    }

    /* 6. Footer Notice */
    .space-organizations-archive-item-button-notice {
        font-size: 11px;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Mobile Tweak - Stack buttons on very small screens to avoid squishing text */
    @media (max-width: 400px) {
        .space-organizations-4-archive-item-buttons {
            flex-direction: column;
        }
    }

    /* Custom CSS-Only Rank Badge (e.g., #1, #2) */
    .offers tr.card::before {
        content: "#" counter(casino-rank);
        position: absolute;
        top: 1px;
        left: 1px;
        background: #0ea5e9; /* Vibrant brand blue */
        color: #ffffff;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: 800;
        font-size: 15px;
        box-shadow: 0 4px 10px rgba(14, 165, 233, 0.3);
        z-index: 10;
    }

    /* ----------------------------------------------------
   3. CARD COLUMNS & CONTENT
---------------------------------------------------- */

    /* Column 1: Logo Area */
    .card-logo {
        grid-area: logo;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .card-logo-link {
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .card-logo picture {
        width: 100px;
        height: 100px;
        border-radius: 50%; /* Perfect circles for logos */
        border: 2px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 12px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }

    .card-logo img {
        max-width: 80%;
        height: auto;
        object-fit: contain;
    }

    .card-name {
        font-weight: 800;
        color: #0f172a;
        font-size: 16px;
    }

    /* Mini Score Badge under Logo */
    .campaign-compact-table__offer-rating-text {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 800;
        color: #334155;
        margin-top: 8px;
    }

    .our-score {
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
    }

    /* Column 2: Main Bonus Text */
    .card-bonus {
        grid-area: bonus;
        padding-right: 16px;
    }

    .card-bonus .bonus {
        font-size: 22px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.3;
    }

    /* Column 3: Rating */
    .card-rating {
        grid-area: rating;
        text-align: center;
    }

    .card-rating .rating {
        font-size: 14px;
        font-weight: 700;
        color: #64748b;
        display: flex;
        align-items: baseline;
        justify-content: center;
    }

    .rating-total {
        font-size: 32px;
        font-weight: 900;
        color: #0ea5e9;
        line-height: 1;
        margin-right: 2px;
    }

    /* Row 2: Bottom Description */
    .card_middle {
        grid-area: desc;
    }

    .card-update {
        display: block;
        color: #475569;
        font-size: 13px;
        line-height: 1.5;
        background: #f8fafc;
        padding: 12px 16px;
        border-radius: 8px;
        border-left: 4px solid #0ea5e9; /* Adds an editorial touch */
    }

    /* Column 4: Play Button & Payments */
    .card-play {
        grid-area: play;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }

    .btn_visit {
        display: block;
        width: 100%;
        text-align: center;
        background: #22c55e; /* High-converting green */
        color: #ffffff;
        padding: 14px 24px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 800;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
    }

    .btn_visit:hover {
        background: #16a34a;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(34, 197, 94, 0.4);
    }

    .paymentmethods {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
    }

    .paymentmethods__item img {
        width: 40px;
        height: 24px;
        object-fit: contain;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        padding: 2px 4px;
    }

    /* ----------------------------------------------------
