// host can never leak into rendered HTML (avatars, thumbnails, etc).
const CLOUDWAYS_DOMAIN_RE = /https?:\/\/[a-z0-9.-]+\.cloudwaysapps\.com/gi
function toRelativeMediaUrl(url: string | undefined | null): string {
    if (!url) return url as any
    if (!/\.cloudwaysapps\.com/i.test(url)) return url
    try {
