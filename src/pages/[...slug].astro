---
import Layout from "../layouts/Layout.astro"

// 1. Fetch data from WordPress (Posts AND Pages)
export async function getStaticPaths() {
    // 🚨 1. SINGLE SOURCE OF TRUTH FOR THE DOMAIN
    const APP_ID = "6467266"
    const wpDomain = `https://wordpress-1164434-${APP_ID}.cloudwaysapps.com`
    const wpUrl = `${wpDomain}/graphql`

    // MUST INCLUDE THIS TO BYPASS CLOUDWAYS BOT PROTECTION
    const safeHeaders = {
        "Content-Type": "application/json",
        "User-Agent":
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    }

    let allNodes: any[] = []
    let allPostsList: any[] = []

    // --- FETCH POSTS ---
    let hasNextPosts = true
    let postsCursor = null

    while (hasNextPosts) {
        const response = await fetch(wpUrl, {
            method: "POST",
            headers: safeHeaders,
            body: JSON.stringify({
                query: `
                    query GetPosts($after: String) {
                        posts(first: 70, after: $after) {
                            pageInfo { hasNextPage endCursor }
                            nodes {
                                uri title content date modified
                                featuredImage { node { sourceUrl altText } }
                                author { node { name firstName lastName uri url avatar { url } seo { social { facebook twitter instagram linkedIn } } } }
                                seo { 
                                    title metaDesc focuskw canonical metaRobotsNoindex metaRobotsNofollow schema { raw } 
                                    breadcrumbs {
                                        text
                                        url
                                    }
                                }
                            }
                        }
                    }
                `,
                variables: { after: postsCursor },
            }),
        })

        const contentType = response.headers.get("content-type")
        if (
            !response.ok ||
            !contentType ||
            !contentType.includes("application/json")
        ) {
            const errText = await response.text()
            console.error(
                "❌ CLOUDWAYS BLOCKED POSTS REQUEST.",
                errText.substring(0, 200),
            )
            throw new Error("Cloudways blocked the Posts fetch request.")
        }

        const result = await response.json()

        if (result.errors) {
            console.error(
                "❌ GRAPHQL POSTS ERROR:",
                JSON.stringify(result.errors, null, 2),
            )
            throw new Error("WordPress rejected the GraphQL query for posts.")
        }

        if (!result?.data?.posts?.nodes) {
            throw new Error(`GraphQL succeeded, but 'posts' are missing.`)
        }

        const postsData = result.data.posts.nodes.map((node: any) => ({
            ...node,
            contentType: "post",
        }))
        allNodes.push(...postsData)
        allPostsList.push(...postsData)

        hasNextPosts = result.data.posts.pageInfo.hasNextPage
        postsCursor = result.data.posts.pageInfo.endCursor
    }

    // --- FETCH PAGES ---
    let hasNextPages = true
    let pagesCursor = null

    while (hasNextPages) {
        const response = await fetch(wpUrl, {
            method: "POST",
            headers: safeHeaders,
            body: JSON.stringify({
                query: `
                    query GetPages($after: String) {
                        pages(first: 70, after: $after) {
                            pageInfo { hasNextPage endCursor }
                            nodes {
                                uri title content date modified
                                featuredImage { node { sourceUrl altText } }
                                author { node { name firstName lastName uri url avatar { url } seo { social { facebook twitter instagram linkedIn } } } }
                                seo { 
                                    title metaDesc focuskw canonical metaRobotsNoindex metaRobotsNofollow schema { raw } 
                                    breadcrumbs {
                                        text
                                        url
                                    }
                                }
                            }
                        }
                    }
                `,
                variables: { after: pagesCursor },
            }),
        })

        const contentType = response.headers.get("content-type")
        if (
            !response.ok ||
            !contentType ||
            !contentType.includes("application/json")
        ) {
            const errText = await response.text()
            console.error(
                "❌ CLOUDWAYS BLOCKED PAGES REQUEST.",
                errText.substring(0, 200),
            )
            throw new Error("Cloudways blocked the Pages fetch request.")
        }

        const result = await response.json()

        if (result.errors) {
            console.error(
                "❌ GRAPHQL PAGES ERROR:",
                JSON.stringify(result.errors, null, 2),
            )
            throw new Error("WordPress rejected the GraphQL query for pages.")
        }

        if (!result?.data?.pages?.nodes) {
            throw new Error(`GraphQL succeeded, but 'pages' are missing.`)
        }

        const pagesData = result.data.pages.nodes.map((node: any) => ({
            ...node,
            contentType: "page",
        }))
        allNodes.push(...pagesData)

        hasNextPages = result.data.pages.pageInfo.hasNextPage
        pagesCursor = result.data.pages.pageInfo.endCursor
    }

    // --- 🚨 FETCH CASINO REVIEWS (CUSTOM POST TYPE) ---
    let hasNextReviews = true
    let reviewsCursor = null

    while (hasNextReviews) {
        const response = await fetch(wpUrl, {
            method: "POST",
            headers: safeHeaders,
            body: JSON.stringify({
                query: `
                    query GetCasinoReviews($after: String) {
                        casinoReviews(first: 70, after: $after) {
                            pageInfo { hasNextPage endCursor }
                            nodes {
                                uri title content excerpt date modified
                                playNowUrl
                                ratingLicensing
                                ratingGames
                                ratingBonuses
                                ratingCustomer
                                featuredImage { node { sourceUrl altText } }
                                author { node { name firstName lastName uri url avatar { url } seo { social { facebook twitter instagram linkedIn } } } }
                                seo { 
                                    title metaDesc focuskw canonical metaRobotsNoindex metaRobotsNofollow schema { raw } 
                                    breadcrumbs { text url }
                                }
                            }
                        }
                    }
                `,
                variables: { after: reviewsCursor },
            }),
        })

        const contentType = response.headers.get("content-type")
        if (
            !response.ok ||
            !contentType ||
            !contentType.includes("application/json")
        ) {
            console.error("❌ CLOUDWAYS BLOCKED REVIEWS REQUEST.")
            break
        }

        const result = await response.json()

        if (result.errors) {
            console.warn("⚠️ GRAPHQL REVIEWS ERROR:", result.errors[0].message)
            break
        }

        if (result?.data?.casinoReviews?.nodes) {
            const reviewsData = result.data.casinoReviews.nodes.map(
                (node: any) => ({
                    ...node,
                    contentType: "post",
                }),
            )
            allNodes.push(...reviewsData)
            allPostsList.push(...reviewsData)

            hasNextReviews = result.data.casinoReviews.pageInfo.hasNextPage
            reviewsCursor = result.data.casinoReviews.pageInfo.endCursor
        } else {
            hasNextReviews = false
        }
    }

    // --- 🚨 NEW: FETCH GAMES (CUSTOM POST TYPE) ---
    let hasNextGames = true
    let gamesCursor = null

    while (hasNextGames) {
        const response = await fetch(wpUrl, {
            method: "POST",
            headers: safeHeaders,
            body: JSON.stringify({
                query: `
                    query GetGames($after: String) {
                        games(first: 70, after: $after) {
                            pageInfo { hasNextPage endCursor }
                            nodes {
                                uri title content excerpt date modified
                                featuredImage { node { sourceUrl altText } }
                                author { node { name firstName lastName uri url avatar { url } seo { social { facebook twitter instagram linkedIn } } } }
                                seo { 
                                    title metaDesc focuskw canonical metaRobotsNoindex metaRobotsNofollow schema { raw } 
                                    breadcrumbs {
                                        text
                                        url
                                    }
                                }
                            }
                        }
                    }
                `,
                variables: { after: gamesCursor },
            }),
        })

        const contentType = response.headers.get("content-type")
        if (
            !response.ok ||
            !contentType ||
            !contentType.includes("application/json")
        ) {
            console.error("❌ CLOUDWAYS BLOCKED GAMES REQUEST.")
            break
        }

        const result = await response.json()

        if (result.errors) {
            console.warn("⚠️ GRAPHQL GAMES ERROR:", result.errors[0].message)
            break
        }

        if (result?.data?.games?.nodes) {
            const gamesData = result.data.games.nodes.map((node: any) => ({
                ...node,
                contentType: "game", // Make it unique!
            }))
            allNodes.push(...gamesData)

            hasNextGames = result.data.games.pageInfo.hasNextPage
            gamesCursor = result.data.games.pageInfo.endCursor
        } else {
            hasNextGames = false
        }
    }

    // --- FILTER AND RETURN ---
    const sanitizeSlug = (uri: string) => {
        if (!uri) return ""
        let clean = uri.replace(/https?:\/\/(www\.)?casinous\.com/gi, "")
        clean = clean.replace(/https?:\/\/(www\.)?au\.crazyvegas\.com/gi, "")
        clean = clean.replace(
            /https?:\/+wordpress-[a-zA-Z0-9-]+\.cloudwaysapps\.com/gi,
            "",
        )
        clean = clean.replace(/https?:[\/]+/gi, "")
        clean = clean.replace(/[:\\]/g, "")
        clean = clean.replace(/\/+/g, "/")
        return clean.replace(/^\/|\/$/g, "")
    }

    const validNodes = allNodes.filter((node: any) => {
        if (!node.uri || node.uri === "/") return false
        return true
    })

    const recentPosts = allPostsList.slice(0, 8)

    return validNodes.map((node: any) => {
        const cleanSlug = sanitizeSlug(node.uri)

        const related =
            node.contentType === "post"
                ? recentPosts.filter(p => p.uri !== node.uri).slice(0, 7)
                : []

        return {
            params: { slug: cleanSlug || undefined },
            props: {
                post: node,
                contentType: node.contentType,
                relatedPosts: related,
            },
        }
    })
}

// 2. Define the Props Interface
interface Props {
    contentType: "post" | "page" | "game"
    relatedPosts: any[]
    post: any
}

const { post, contentType, relatedPosts } = Astro.props
const { slug } = Astro.params

// --- Dynamic Ratings Calculation ---
const rLicensing = post.ratingLicensing || 0
const rGames = post.ratingGames || 0
const rBonuses = post.ratingBonuses || 0
const rCustomer = post.ratingCustomer || 0

// Calculate average out of 5, fallback to 4.9 (9.8/10) if unrated
const averageFive = (rLicensing + rGames + rBonuses + rCustomer) / 4
const rating = averageFive > 0 ? averageFive : 4.9
const overallScore = (rating * 2).toFixed(1)

// Generate an array of 5 values representing the percentage fill for each star slot
const starFills = Array.from({ length: 5 }, (_, index) => {
    const fillValue = (rating - index) * 100
    return Math.max(0, Math.min(100, fillValue)) // Clamp between 0% and 100%
})

// 🚨 SPLIT THE POSTS FOR THE FOOTER LAYOUT
const breakingStories = relatedPosts.slice(0, 3)
const blogPosts = relatedPosts.slice(3, 7)

const isPost = contentType === "post"
const isPage = contentType === "page"
const isGame = contentType === "game" // Unique identifier for Games

// 🚨 The /casino-reviews/ INDEX page must use the normal page hero,
// so it is explicitly excluded from the review-hero template.
const isReviewIndex =
    post.uri === "/casino-reviews/" || slug === "casino-reviews"

const isReview =
    post.uri && post.uri.startsWith("/casino-reviews/") && !isReviewIndex

// --- 🚨 CLAIM BONUS / PLAY NOW URL ---
// Individual reviews pull the WP "External URL for the Play Now button" field.
const cleanPlayUrl = (url: string | undefined | null) => {
    if (!url) return null
    let u = url.trim()
    // Turn internal WP / live links into relative paths; leave true affiliate links alone
    u = u.replace(/https?:\/\/(www\.)?au\.crazyvegas\.com/gi, "")
    u = u.replace(/https?:\/+wordpress-[a-zA-Z0-9-]+\.cloudwaysapps\.com/gi, "")
    return u || null
}

let claimUrl = "#visit" // safe fallback
if (isReview) {
    claimUrl = cleanPlayUrl(post.playNowUrl) || "#visit"
}

// External affiliate links open in a new tab + get nofollow; internal links don't
const claimIsExternal = /^https?:\/\//i.test(claimUrl)

const pathSegments = slug?.split("/") || []
const category = pathSegments.length > 1 ? pathSegments[0] : "guide"
const cleanCategoryName = category.replace(/-/g, " ")

const currentYear = new Date().getFullYear().toString()

const yoastTitle = (post.seo?.title || post.title || "").replaceAll(
    "[year]",
    currentYear,
)
const yoastDesc = (post.seo?.metaDesc || "").replaceAll("[year]", currentYear)

// 🚨 FIX: Swap the Cloudways domain for the live domain in the Schema
let yoastSchema = post.seo?.schema?.raw || undefined
if (yoastSchema) {
    yoastSchema = yoastSchema.replaceAll(
        "https://wordpress-1164434-6467266.cloudwaysapps.com",
        "https://au.crazyvegas.com",
    )
}

// 🚨 FIX: Force the Yoast canonical URL to use the live domain
let canonicalUrl = post.seo?.canonical || undefined
if (canonicalUrl) {
    canonicalUrl = canonicalUrl.replace(
        "https://wordpress-1164434-6467266.cloudwaysapps.com",
        "https://au.crazyvegas.com",
    )
}
const focusKeyword = post.seo?.focuskw || undefined

// 🚨 NEW: Extract and clean Yoast Breadcrumbs
const rawBreadcrumbs = post.seo?.breadcrumbs || []
const yoastBreadcrumbs = rawBreadcrumbs.map((crumb: any, index: number) => {
    let cleanUrl = crumb.url || "/"

    // Strip both the live domain and the Cloudways domain to make links relative
    cleanUrl = cleanUrl.replace(/https?:\/\/(www\.)?casinous\.com/gi, "")
    cleanUrl = cleanUrl.replace(/https?:\/\/(www\.)?au\.crazyvegas\.com/gi, "")
    cleanUrl = cleanUrl.replace(
        /https?:\/+wordpress-[a-zA-Z0-9-]+\.cloudwaysapps\.com/gi,
        "",
    )

    if (cleanUrl === "") cleanUrl = "/"

    const isLastItem = index === rawBreadcrumbs.length - 1

    // 🚨 Override the text with the Focus Keyword if it is the last item in the chain
    let displayText = crumb.text
    if (isLastItem && focusKeyword) {
        displayText =
            focusKeyword.charAt(0).toUpperCase() + focusKeyword.slice(1)
    }

    return {
        text: displayText,
        url: cleanUrl,
        isLast: isLastItem,
    }
})

const noindex = post.seo?.metaRobotsNoindex || "index"
const nofollow = post.seo?.metaRobotsNofollow || "follow"
const robotsTag = `${noindex}, ${nofollow}`

// 5. Author Data Extraction
const wpDomain = "https://wordpress-1164434-6467266.cloudwaysapps.com"
const authorNode = post.author?.node
const authorName = authorNode
    ? authorNode.firstName && authorNode.lastName
        ? `${authorNode.firstName} ${authorNode.lastName}`
        : authorNode.name
    : "Editorial Team"

// Build the author slug once — used for both the avatar lookup and the profile link
const authorSlug = authorName
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)+/g, "")

// 🚨 MANUAL AVATAR OVERRIDES (keyed by author slug)
// Keep paths relative so they resolve the same way as featuredImageUrl.
const manualAvatars: Record<string, string> = {
    "caleb-daly": "/wp-content/uploads/2026/03/caleb-daly.png",
    "kayla-mcbrien": "/wp-content/uploads/2026/03/kayla-mcbrien.png",
    "daphne-hutchens": "/wp-content/uploads/2026/03/daphne-hutchens.png",
}

// 🚨 DEFAULT relevant fallback image — a REAL editorial photo, never a
// random generated avatar. Swap this for whatever default you upload to WP.
const DEFAULT_AVATAR = "/wp-content/uploads/2026/03/mason-j.png"

let authorAvatar =
    manualAvatars[authorSlug] || // 1. manual override (real photo)
    authorNode?.avatar?.url || // 2. dynamic WP gravatar
    DEFAULT_AVATAR // 3. relevant default (real image)
authorAvatar = authorAvatar.replace(
    /https?:\/\/(www\.)?casinous\.com/gi,
    wpDomain,
)
authorAvatar = authorAvatar.replace(
    /https?:\/\/(www\.)?au\.crazyvegas\.com/gi,
    wpDomain,
)

const authorLink = `/about-us/${authorSlug}/`

const formatSocial = (value: string | undefined, domain: string) => {
    if (!value) return null
    return value.startsWith("http")
        ? value
        : `${domain}${value.replace(/^@/, "")}`
}

const authorSocials = authorNode?.seo?.social || {}
const twitterLink = formatSocial(authorSocials.twitter, "https://twitter.com/")
const facebookLink = formatSocial(
    authorSocials.facebook,
    "https://facebook.com/",
)
const instagramLink = formatSocial(
    authorSocials.instagram,
    "https://instagram.com/",
)
const linkedinLink = formatSocial(
    authorSocials.linkedIn,
    "https://linkedin.com/in/",
)

// --- REVIEWER ASSIGNMENT (deterministic — never the same person as the author) ---
const REVIEWER_POOL = [
    {
        name: "Caleb Daly",
        slug: "caleb-daly",
        avatar: "/wp-content/uploads/2026/03/caleb-daly.png",
    },
    {
        name: "Daphne Hutchens",
        slug: "daphne-hutchens",
        avatar: "/wp-content/uploads/2026/03/daphne-hutchens.png",
    },
    {
        name: "Kayla McBrien",
        slug: "kayla-mcbrien",
        avatar: "/wp-content/uploads/2026/03/kayla-mcbrien.png",
    },
    {
        name: "Mason Heaton",
        slug: "mason-heaton",
        avatar: DEFAULT_AVATAR, // Mason's own default photo
    },
]

// Simple, stable string hash — same author name always produces the same
// number, so reviewer assignment stays fixed across builds/deploys (no
// Math.random, which would reshuffle reviewers every time you rebuild)
function stableHash(str: string) {
    let hash = 0
    for (let i = 0; i < str.length; i++) {
        hash = (hash << 5) - hash + str.charCodeAt(i)
        hash |= 0
    }
    return Math.abs(hash)
}

function getReviewerFor(author: string) {
    const authorKey = author.toLowerCase().trim()
    const authorSlugified = authorKey
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)+/g, "")

    let index = stableHash(authorKey) % REVIEWER_POOL.length
    let candidate = REVIEWER_POOL[index]

    // If the hash happens to land on the same person as the author,
    // shift forward through the pool until we find someone different
    let attempts = 0
    while (
        candidate.slug === authorSlugified &&
        attempts < REVIEWER_POOL.length
    ) {
        index = (index + 1) % REVIEWER_POOL.length
        candidate = REVIEWER_POOL[index]
        attempts++
    }
    return candidate
}

const assignedReviewer = getReviewerFor(authorName)
const reviewerName = assignedReviewer.name

let reviewerAvatar = assignedReviewer.avatar
reviewerAvatar = reviewerAvatar.replace(
    /https?:\/\/(www\.)?casinous\.com/gi,
    wpDomain,
)
reviewerAvatar = reviewerAvatar.replace(
    /https?:\/\/(www\.)?au\.crazyvegas\.com/gi,
    wpDomain,
)

const reviewerSlug = assignedReviewer.slug
const reviewerLink = `/about-us/${reviewerSlug}/`

const rawDate = post.modified || post.date || new Date().toISOString()
const formattedDate = new Date(rawDate).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
})

let featuredImageUrl = post.featuredImage?.node?.sourceUrl
if (featuredImageUrl) {
    try {
        const parsedUrl = new URL(featuredImageUrl)
        featuredImageUrl = parsedUrl.pathname
    } catch (e) {}
}

// --- 6. AUTO TABLE OF CONTENTS (TOC) GENERATOR ---
let rawContent = post.content || ""

if (post.uri.startsWith("/casino-reviews/")) {
    rawContent = rawContent.replace(/<h1[^>]*>[\s\S]*?<\/h1>/gi, "")
}

const tocItems: { text: string; slug: string }[] = []
const h2Regex = /<h2([^>]*)>([\s\S]*?)<\/h2>/gi
const contentWithIds = rawContent.replace(
    h2Regex,
    (match, attributes, text) => {
        const cleanText = text.replace(/<\/?[^>]+(>|$)/g, "").trim()
        const h2Slug = cleanText
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/(^-|-$)+/g, "")
        if (cleanText.length > 0)
            tocItems.push({ text: cleanText, slug: h2Slug })
        if (attributes.includes("id=")) return match
        return `<h2${attributes} id="${h2Slug}">${text}</h2>`
    },
)

let tocHTML = ""
if (tocItems.length > 0) {
    const listItems = tocItems
        .map(
            item =>
                `<li><a href="#${item.slug}" class="toc-jump-link">${item.text}</a></li>`,
        )
        .join("")
    tocHTML = `
    <div class="custom-toc">
        <button class="toc-toggle" onclick="window.toggleTableOfContents(this)">
            <span>Table of Contents</span>
            <svg class="toc-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <ul class="toc-list" style="display: none;">${listItems}</ul>
    </div>`
}

const displayTitle = (post.title || "").replaceAll("[year]", currentYear)

// Strip every Cloudways host variant -> root-relative path
function stripWp(input = "") {
    const hosts = [
        "https://wordpress-1164434-6467266.cloudwaysapps.com",
        "http://wordpress-1164434-6467266.cloudwaysapps.com",
        "https://www.wordpress-1164434-6467266.cloudwaysapps.com",
        "http://www.wordpress-1164434-6467266.cloudwaysapps.com",
        "//wordpress-1164434-6467266.cloudwaysapps.com",
    ]
    let out = input
    for (const h of hosts) out = out.split(h).join("")
    return out
}

// --- 7. FINAL CONTENT REPLACEMENTS ---
let fixedContent = contentWithIds
    .replaceAll("[casino_toc]", tocHTML)

    // 1. Strip the WP domain FIRST so absolute lazy URLs become relative
    .replaceAll(wpDomain, "")

    // 2. Remove placeholder + inline data-URI srcs that lazy plugins inject
    .replace(/src="[^"]*placeholder[^"]*"/gi, "")
    .replace(/\ssrc="data:image\/[^"]*"/gi, "")

    // 3. Promote EVERY lazy attribute to the real one (covers all plugins)
    .replace(/data-srcset=/gi, "srcset=")
    .replace(/data-lazy-srcset=/gi, "srcset=")
    .replace(/data-src=/gi, "src=")
    .replace(/data-lazy-src=/gi, "src=")

    .replaceAll("<img ", '<img referrerpolicy="no-referrer" ')
    .replaceAll("<p>&nbsp;</p>", "")
    .replace(
        /<p>\s*<(strong|b)>\s*Accepts players from:\s*<\/(strong|b)>.*?<\/p>/gi,
        "",
    )
    .replace(
        /<p[^>]*>\s*<(strong|b)[^>]*>\s*Last Update:\s*<\/(strong|b)>[\s\S]*?<\/p>/gi,
        "",
    )
    .replace(
        /<p>\s*<(strong|b)>.*?Reviews and Ratings\s*<\/(strong|b)>\s*<\/p>/gi,
        "",
    )
    .replace(/<p>\s*\[casino_toc\]\s*<\/p>/gi, "")
    .replaceAll("[casino_toc]", "")
    .replace(/<p>\s*<(strong|b)>\s*Updated:\s*<\/(strong|b)>.*?<\/p>/gi, "")
    .replace(/<h1[^>]*>[\s\S]*?<\/h1>/i, "")

    .replace(
        /(<div[^>]*id="demo"[^>]*>\s*)<table>/i,
        '$1<table class="offers">',
    )
    .replaceAll("[year]", currentYear)

// 🚨 CONDITIONAL LOGIC FOR [author_reviewer]
const isHomepage = !slug || slug === "/"

if (!isHomepage) {
    fixedContent = fixedContent
        .replaceAll("<p>[author_reviewer]</p>", "")
        .replaceAll("[author_reviewer]", "")
}
// 🚨 FINAL SWEEP: remove every Cloudways host variant from anchor hrefs etc.
fixedContent = stripWp(fixedContent)
---

<Layout
    title={`${post.title} | AU Casinos Online`}
    seoTitle={yoastTitle}
    description={yoastDesc}
    schema={yoastSchema}
    canonical={canonicalUrl}
    robots={robotsTag}
    keywords={focusKeyword}
    author={authorName}
>
    {/* UNIQUE LAYOUT FOR GAMES */}
    {
        isGame ? (
            <header class="game-hero">
                <div class="game-hero-inner">
                    <nav
                        class="post-breadcrumbs dark-breadcrumbs"
                        aria-label="breadcrumb"
                    >
                        {yoastBreadcrumbs.length > 0 ? (
                            yoastBreadcrumbs.map((crumb: any) =>
                                crumb.isLast ? (
                                    <span
                                        class="current"
                                        set:html={crumb.text}
                                    />
                                ) : (
                                    <>
                                        <a
                                            href={crumb.url}
                                            set:html={crumb.text}
                                        />
                                        <span class="separator">›</span>
