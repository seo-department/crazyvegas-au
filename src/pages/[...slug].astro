function truncateText(text: string, maxChars = 130): string {
    const clean = (text || "").trim()
    if (clean.length <= maxChars) return clean
    // Cut at the last full word before the limit so it doesn't chop mid-word
    const cut = clean.slice(0, maxChars)
    const lastSpace = cut.lastIndexOf(" ")
    return `${cut.slice(0, lastSpace > 0 ? lastSpace : maxChars)}…`
}

async function fetchTooltipPersonData(displayName: string, currentUri: string) {
    const fallback = { sinceLabel: null as string | null, posts: [] as { title: string; uri: string }[] }
    if (!displayName) return fallback

    try {
        const response = await fetch(tooltipWpUrl, {
            method: "POST",
            headers: tooltipSafeHeaders,
            body: JSON.stringify({
                query: `
                    query AuthorTooltipData($search: String!) {
                        users(where: { search: $search }, first: 10) {
                            nodes {
                                name
                                registeredDate
                                posts(first: 6) {
                                    nodes { title uri }
                                }
                            }
                        }
                    }
                `,
                variables: { search: displayName },
            }),
        })

        const contentType = response.headers.get("content-type")
        if (!response.ok || !contentType?.includes("application/json")) {
            console.warn(
                "⚠️ CLOUDWAYS BLOCKED TOOLTIP USERS REQUEST for",
                displayName,
            )
            return fallback
        }

        const result = await response.json()

        if (result.errors) {
            console.warn(
                "⚠️ GRAPHQL TOOLTIP USERS ERROR for",
                displayName,
                JSON.stringify(result.errors),
            )
            return fallback
        }

        const candidates = result?.data?.users?.nodes || []
        // "search" can return partial/fuzzy matches, so pick the exact
        // display-name match if one exists; otherwise fall back to the
        // first candidate returned.
        const user =
            candidates.find(
                (u: any) =>
                    (u.name || "").trim().toLowerCase() ===
                    displayName.trim().toLowerCase(),
            ) || candidates[0]

        if (!user) {
            console.warn("⚠️ No WP user match found for", displayName)
            return fallback
        }

        const sinceLabel = user.registeredDate
            ? new Date(user.registeredDate).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
              })
            : null

        const posts = (user.posts?.nodes || [])
            .filter((p: any) => p.uri && p.uri !== currentUri)
            .slice(0, 5)
            .map((p: any) => ({
                title: p.title,
                uri: stripWp(
                    p.uri.replace(/https?:\/\/[^\/]+/g, ""),
                ),
            }))

        return { sinceLabel, posts }
    } catch (e) {
        console.warn("⚠️ Could not fetch tooltip data for", displayName, e)
        return fallback
    }
}

function buildTooltipHtml(opts: {
    roleLabel: string
    name: string
    avatar: string
    bio: string
    since: string | null
    posts: { title: string; uri: string }[]
    profileLink: string
}): string {
    const { roleLabel, name, avatar, bio, since, posts, profileLink } = opts

    const sinceHtml = since
        ? `<div class="atp-since"><span class="atp-since-label">Part of the Team Since</span><span class="atp-since-value">${since}</span></div>`
        : ""

    const postsHtml =
        posts.length > 0
            ? `
        <div class="atp-section-label">Has Also Written</div>
        <ul class="atp-posts-list">
            ${posts
                .map(
                    p =>
                        `<li><a href="${p.uri}">${p.title}</a></li>`,
                )
                .join("")}
        </ul>`
            : ""

    return `
        <div class="atp-header">
            <img src="${avatar}" alt="${name}" class="atp-avatar" referrerpolicy="no-referrer" />
            <div class="atp-header-text">
                <span class="atp-role">${roleLabel}</span>
                <strong class="atp-name">${name}</strong>
            </div>
            ${sinceHtml}
        </div>
        <div class="atp-section-label">About ${roleLabel === "Author" ? "Author" : "Reviewer"}</div>
        <p class="atp-bio">${truncateText(bio.replace(/<\/?[^>]+(>|$)/g, ""), 130)}</p>
        ${postsHtml}
        <a href="${profileLink}" class="atp-profile-btn">
            ${roleLabel === "Author" ? "Author" : "Reviewer"} Profile
            <i class="fa-solid fa-chevron-right"></i>
        </a>
    `
}

const [authorTooltipInfo, reviewerTooltipInfo] = await Promise.all([
    fetchTooltipPersonData(authorName, post.uri),
    fetchTooltipPersonData(reviewerName, post.uri),
])

const authorTooltipHtml = buildTooltipHtml({
    roleLabel: "Author",
    name: authorName,
    avatar: authorAvatar,
    bio: authorBio,
    since: authorTooltipInfo.sinceLabel,
    posts: authorTooltipInfo.posts,
    profileLink: authorLink,
})

const reviewerTooltipHtml = buildTooltipHtml({
    roleLabel: "Reviewer",
    name: reviewerName,
    avatar: reviewerAvatar,
    bio: reviewerBio,
    since: reviewerTooltipInfo.sinceLabel,
    posts: reviewerTooltipInfo.posts,
    profileLink: reviewerLink,
})

const rawDate = post.modified || post.date || new Date().toISOString()
const formattedDate = new Date(rawDate).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
})

let featuredImageUrl = post.featuredImage?.node?.sourceUrl
if (featuredImageUrl) {
    try {
        const parsedUrl = new URL(featuredImageUrl)
        featuredImageUrl = parsedUrl.pathname
    } catch (e) {}
}

// --- 6. AUTO TABLE OF CONTENTS (TOC) GENERATOR ---
let rawContent = post.content || ""

if (post.uri.startsWith("/casino-reviews/")) {
    rawContent = rawContent.replace(/<h1[^>]*>[\s\S]*?<\/h1>/gi, "")
}

const tocItems: { text: string; slug: string }[] = []
const h2Regex = /<h2([^>]*)>([\s\S]*?)<\/h2>/gi
const contentWithIds = rawContent.replace(
    h2Regex,
    (match, attributes, text) => {
        const cleanText = text.replace(/<\/?[^>]+(>|$)/g, "").trim()
        const h2Slug = cleanText
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/(^-|-$)+/g, "")
        if (cleanText.length > 0)
            tocItems.push({ text: cleanText, slug: h2Slug })
        if (attributes.includes("id=")) return match
        return `<h2${attributes} id="${h2Slug}">${text}</h2>`
    },
)

let tocHTML = ""
if (tocItems.length > 0) {
    const listItems = tocItems
        .map(
            item =>
                `<li><a href="#${item.slug}" class="toc-jump-link">${item.text}</a></li>`,
        )
        .join("")
    tocHTML = `
    <div class="custom-toc">
        <button class="toc-toggle" onclick="window.toggleTableOfContents(this)">
            <span>Table of Contents</span>
            <svg class="toc-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <ul class="toc-list" style="display: none;">${listItems}</ul>
    </div>`
}

const displayTitle = (post.title || "").replaceAll("[year]", currentYear)

// Strip every Cloudways host variant -> root-relative path
function stripWp(input = "") {
    const hosts = [
        "https://wordpress-1164434-6467266.cloudwaysapps.com",
        "http://wordpress-1164434-6467266.cloudwaysapps.com",
        "https://www.wordpress-1164434-6467266.cloudwaysapps.com",
        "http://www.wordpress-1164434-6467266.cloudwaysapps.com",
        "//wordpress-1164434-6467266.cloudwaysapps.com",
    ]
    let out = input
    for (const h of hosts) out = out.split(h).join("")
    return out
}

// --- 7. FINAL CONTENT REPLACEMENTS ---
let fixedContent = contentWithIds
    .replaceAll("[casino_toc]", tocHTML)

    // 1. Strip the WP domain FIRST so absolute lazy URLs become relative
    .replaceAll(wpDomain, "")

    // 2. Remove placeholder + inline data-URI srcs that lazy plugins inject
    .replace(/src="[^"]*placeholder[^"]*"/gi, "")
    .replace(/\ssrc="data:image\/[^"]*"/gi, "")

    // 3. Promote EVERY lazy attribute to the real one (covers all plugins)
    .replace(/data-srcset=/gi, "srcset=")
    .replace(/data-lazy-srcset=/gi, "srcset=")
    .replace(/data-src=/gi, "src=")
    .replace(/data-lazy-src=/gi, "src=")

    .replaceAll("<img ", '<img referrerpolicy="no-referrer" ')
    .replaceAll("<p>&nbsp;</p>", "")
    .replace(
        /<p>\s*<(strong|b)>\s*Accepts players from:\s*<\/(strong|b)>.*?<\/p>/gi,
        "",
    )
    .replace(
        /<p[^>]*>\s*<(strong|b)[^>]*>\s*Last Update:\s*<\/(strong|b)>[\s\S]*?<\/p>/gi,
        "",
    )
    .replace(
        /<p>\s*<(strong|b)>.*?Reviews and Ratings\s*<\/(strong|b)>\s*<\/p>/gi,
        "",
    )
    .replace(/<p>\s*\[casino_toc\]\s*<\/p>/gi, "")
    .replaceAll("[casino_toc]", "")
    .replace(/<p>\s*<(strong|b)>\s*Updated:\s*<\/(strong|b)>.*?<\/p>/gi, "")
    .replace(/<h1[^>]*>[\s\S]*?<\/h1>/i, "")

    .replace(/<div[^>]*id="toc_container"[^>]*>[\s\S]*?<\/div>/gi, "")

    .replace(
        /(<div[^>]*id="demo"[^>]*>\s*)<table>/i,
        '$1<table class="offers">',
    )
    .replaceAll("[year]", currentYear)

// 🚨 CONDITIONAL LOGIC FOR [author_reviewer]
const isHomepage = !slug || slug === "/"

if (!isHomepage) {
    fixedContent = fixedContent
        .replaceAll("<p>[author_reviewer]</p>", "")
        .replaceAll("[author_reviewer]", "")
}
// 🚨 FINAL SWEEP: remove every Cloudways host variant from anchor hrefs etc.
fixedContent = stripWp(fixedContent)
