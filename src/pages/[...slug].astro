// Simple, stable string hash — same author name always produces the same
// number, so reviewer assignment stays fixed across builds/deploys (no
// Math.random, which would reshuffle reviewers every time you rebuild)
function stableHash(str: string) {
    let hash = 0
    for (let i = 0; i < str.length; i++) {
        hash = (hash << 5) - hash + str.charCodeAt(i)
        hash |= 0
    }
    return Math.abs(hash)
}

function getReviewerFor(author: string) {
    const authorKey = author.toLowerCase().trim()
    const authorSlugified = authorKey
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)+/g, "")

    let index = stableHash(authorKey) % REVIEWER_POOL.length
    let candidate = REVIEWER_POOL[index]

    // If the hash happens to land on the same person as the author,
    // shift forward through the pool until we find someone different
    let attempts = 0
    while (
        candidate.slug === authorSlugified &&
        attempts < REVIEWER_POOL.length
    ) {
        index = (index + 1) % REVIEWER_POOL.length
        candidate = REVIEWER_POOL[index]
        attempts++
    }
    return candidate
}

