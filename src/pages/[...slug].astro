<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Find all FAQ question links
        const faqHeaders = document.querySelectorAll(".panel-title")

        faqHeaders.forEach(function (header) {
            header.addEventListener("click", function (e) {
                e.preventDefault() // Stops the page from jumping when clicking the link

                const currentPanel = this.closest(".panel")
                const isCurrentlyActive =
                    currentPanel.classList.contains("active")

                // Close all other FAQ panels
                document.querySelectorAll(".panel").forEach(function (panel) {
                    panel.classList.remove("active")
                    panel
                        .querySelector(".panel-title")
                        .setAttribute("aria-expanded", "false")
                })

                // Toggle the one we just clicked
                if (!isCurrentlyActive) {
                    currentPanel.classList.add("active")
                    this.setAttribute("aria-expanded", "true")
                }
            })
        })
    })
</script>
