       and for any future contentType that still calls it)
    ========================================= */
    .post-hero {
        background-color: #0f172a;
        color: #ffffff;
        padding: 4rem 1rem 3rem;
        position: relative;
        overflow: visible;
    }
    .post-hero-container {
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }
    .post-title {
        font-size: 2.8rem;
        font-weight: 900;
        line-height: 1.2;
        margin: 0 0 2rem 0;
        letter-spacing: -0.5px;
        color: #ffffff;
    }

    .page-hero {
        background-color: #1a233a;
        color: #ffffff;
        padding: 3rem 1rem;
        border-bottom: 1px solid #3a4459;
    }
    .page-hero-container {
        max-width: 1200px;
        margin: 0 auto;
    }
    .page-title {
