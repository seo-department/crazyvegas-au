    }

    .post-breadcrumbs {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: #94a3b8;
        margin-bottom: 1.5rem;
        font-weight: 500;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }
    .post-breadcrumbs a {
        color: #60a5fa;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .post-breadcrumbs a:hover {
        color: #93c5fd;
    }
    .post-breadcrumbs .separator {
        color: #475569;
    }
    .post-breadcrumbs .current {
        color: #e2e8f0;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 300px;
    }

    .post-meta-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #1e293b;
        padding-top: 1.5rem;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .meta-reviewer {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding-left: 1.5rem;
        margin-left: 1.5rem;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
    }

    @media (max-width: 900px) {
        .post-meta-bar {
            justify-content: flex-start;
        }
        .meta-reviewer {
            border-left: none;
            padding-left: 0;
            margin-left: 0;
        }
    }
    .meta-author {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .author-image-link {
        display: block;
        transition: transform 0.2s ease;
    }
    .author-image-link:hover {
        transform: scale(1.05);
    }
    .meta-avatar {
        width: 100px !important;
        height: 100px !important;
        border-radius: 50%;
        border: 2px solid #334155;
        object-fit: cover;
        flex-shrink: 0;
    }
    .meta-name {
        display: block;
        font-size: 1rem;
        color: #cbd5e1;
    }
    .author-text-link {
        color: #ffffff;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .author-text-link:hover {
        color: #60a5fa;
        text-decoration: underline;
    }
    .meta-date {
        display: block;
        font-size: 0.85rem;
        color: #94a3b8;
        margin-top: 0.2rem;
    }

    .meta-share {
        display: flex;
