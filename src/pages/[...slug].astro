<script is:inline>
    window.toggleTableOfContents = function (btn) {
        const list = btn.nextElementSibling
        const icon = btn.querySelector(".toc-icon")

        if (list.style.display === "none") {
            list.style.display = "block"
            icon.style.transform = "rotate(180deg)"
        } else {
            list.style.display = "none"
            icon.style.transform = "rotate(0deg)"
        }
    }

    document.addEventListener("click", function (e) {
        const link = e.target.closest(".toc-jump-link")
        if (!link) return

        e.preventDefault()

        const targetId = link.getAttribute("href").substring(1)
        const targetElement = document.getElementById(targetId)

        if (targetElement) {
            targetElement.scrollIntoView({ behavior: "smooth", block: "start" })
            history.pushState(null, null, `#${targetId}`)
        }
    })

    // Toggle Content Functions
    window.toggleContent = function (btn) {
        const content = btn.parentElement.nextElementSibling
        if (content.style.display === "block") {
            content.style.display = "none"
            btn.innerText = "Show more"
        } else {
            content.style.display = "block"
            btn.innerText = "Show less"
        }
    }
</script>

<script is:inline>
    // 🚨 GI HERO SHARE MENU — shares the exact page the visitor is on
    // across the platforms most used in Australia.
    document.addEventListener("astro:page-load", initGiShareMenu)
    document.addEventListener("DOMContentLoaded", initGiShareMenu)

    function initGiShareMenu() {
        const toggle = document.querySelector("[data-gi-share-toggle]")
        const menu = document.querySelector("[data-gi-share-menu]")
        if (!toggle || !menu || toggle.dataset.giShareBound === "true") return
        toggle.dataset.giShareBound = "true"

        const pageUrl = window.location.href
        const pageTitle = document.title

        const shareUrls = {
            facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`,
            x: `https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(pageTitle)}`,
            whatsapp: `https://api.whatsapp.com/send?text=${encodeURIComponent(pageTitle + " " + pageUrl)}`,
            messenger: `https://www.facebook.com/dialog/send?link=${encodeURIComponent(pageUrl)}&app_id=966242223397117&redirect_uri=${encodeURIComponent(pageUrl)}`,
            reddit: `https://www.reddit.com/submit?url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(pageTitle)}`,
            linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`,
            email: `mailto:?subject=${encodeURIComponent(pageTitle)}&body=${encodeURIComponent(pageUrl)}`,
        }

        menu.querySelectorAll("[data-gi-share]").forEach(el => {
            const key = el.getAttribute("data-gi-share")
            if (key === "copy") {
                el.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(pageUrl)
                    } catch {
                        const tmp = document.createElement("input")
                        tmp.value = pageUrl
                        document.body.appendChild(tmp)
                        tmp.select()
                        document.execCommand("copy")
                        tmp.remove()
                    }
                    const original = el.innerHTML
                    el.classList.add("gi-share-copied")
                    el.innerHTML =
                        '<i class="fa-solid fa-check"></i> Link copied'
                    setTimeout(() => {
                        el.classList.remove("gi-share-copied")
                        el.innerHTML = original
                    }, 1800)
                })
            } else if (shareUrls[key]) {
                el.setAttribute("href", shareUrls[key])
            }
        })

        toggle.addEventListener("click", e => {
            e.stopPropagation()
            const isOpen = menu.classList.toggle("gi-share-open")
            toggle.setAttribute("aria-expanded", isOpen ? "true" : "false")
        })

        document.addEventListener("click", e => {
            if (!menu.contains(e.target) && e.target !== toggle) {
                menu.classList.remove("gi-share-open")
                toggle.setAttribute("aria-expanded", "false")
            }
        })

        document.addEventListener("keydown", e => {
            if (e.key === "Escape") {
                menu.classList.remove("gi-share-open")
                toggle.setAttribute("aria-expanded", "false")
            }
        })
    }
</script>

