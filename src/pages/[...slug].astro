    /* ----------------------------------------------------
   1. TABLE RESET & WRAPPER
---------------------------------------------------- */
    .offers {
        width: 100%;
        border-collapse: collapse;
        display: flex;
        flex-direction: column;
        gap: 24px;
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
    }

    .offers thead {
        display: none;
    }

    .offers tbody {
        display: flex;
        flex-direction: column;
        gap: 24px;
        width: 100%;
        counter-reset: casino-rank;
    }

    .offers td {
        display: block;
        padding: 0;
        border: none;
    }

    .offers tr.card {
        position: relative;
        counter-increment: casino-rank;
        display: grid;
        grid-template-columns: 200px 1fr 140px 220px;
        grid-template-areas:
            "logo bonus rating play"
            "logo desc desc play";
        gap: 16px;
        align-items: center;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .offers tr.card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.1);
        border-color: #cbd5e1;
    }

    table.offers {
        border: unset;
        box-shadow: unset;
    }

    .offers tr.card::before {
        content: "#" counter(casino-rank);
        position: absolute;
        top: 1px;
        left: 1px;
        background: #0ea5e9;
        color: #ffffff;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: 800;
        font-size: 15px;
        box-shadow: 0 4px 10px rgba(14, 165, 233, 0.3);
        z-index: 10;
    }

    .card-logo {
        grid-area: logo;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .card-logo-link {
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .card-logo picture {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 2px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 12px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }

    .card-logo img {
        max-width: 80%;
        height: auto;
        object-fit: contain;
    }

    .card-name {
        font-weight: 800;
        color: #0f172a;
        font-size: 16px;
    }

    .card-bonus {
        grid-area: bonus;
        padding-right: 16px;
    }

    .card-bonus .bonus {
        font-size: 22px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.3;
    }

    .card-rating {
        grid-area: rating;
        text-align: center;
    }

    .card-rating .rating {
        font-size: 14px;
        font-weight: 700;
        color: #64748b;
        display: flex;
        align-items: baseline;
        justify-content: center;
    }

    .rating-total {
        font-size: 32px;
        font-weight: 900;
        color: #0ea5e9;
        line-height: 1;
        margin-right: 2px;
    }

    .card_middle {
        grid-area: desc;
    }

    .card-update {
        display: block;
        color: #475569;
        font-size: 13px;
        line-height: 1.5;
        background: #f8fafc;
        padding: 12px 16px;
        border-radius: 8px;
        border-left: 4px solid #0ea5e9;
