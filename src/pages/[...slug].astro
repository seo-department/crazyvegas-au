const stripHtmlTags = (html: string) => {
    if (!html) return ""
    return html.replace(/<\/?[^>]+(>|$)/g, "").trim()
}

// Bold every occurrence of `name` inside `text`. We build this HTML
// ourselves from already-tag-stripped text, so it's safe to render with
