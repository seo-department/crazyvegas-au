			toc.innerHTML = `
          <div class="toc_title">
              <span class="title-text">Table Of Contents</span>
              <span class="toc-btn" id="toc_btn_text">Show</span>
          </div>
          <ul class="toc_list">
            ${items.map(i => `<li><a href="#${i.id}">${i.text}</a></li>`).join("")}
          </ul>
        `

			const disclaimerBox = document.querySelector(".hero-disclaimer-box")

			if (disclaimerBox) {
				disclaimerBox.insertAdjacentElement("afterend", toc)
			} else {
				article.insertBefore(toc, article.firstChild)
			}

			// Toggle functionality
			const tocTitle = toc.querySelector(".toc_title")
			const btnText = toc.querySelector("#toc_btn_text")

			tocTitle.addEventListener("click", () => {
				const isOpen = toc.classList.toggle("is-open")
				btnText.textContent = isOpen ? "Hide" : "Show"
			})
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", buildToc)
		} else {
			buildToc()
		}

		// Re-run on Astro client-side navigations (view transitions), if used
		document.addEventListener("astro:page-load", buildToc)
	})()
</script>

<script is:inline>
	// FIX: Explictly check visibility state so it never gets confused
	window.toggleCustomBlock = function (btn, targetId) {
		const hiddenBlock = document.getElementById(targetId)
		if (!hiddenBlock) return

		const isVisible =
			window.getComputedStyle(hiddenBlock).display === "block"

		if (isVisible) {
			// Collapse
			hiddenBlock.style.display = "none"
			btn.innerHTML = 'Show More <i class="fa-solid fa-chevron-down"></i>'
			btn.setAttribute("aria-expanded", "false")
		} else {
			// Expand
			hiddenBlock.style.display = "block"
			btn.innerHTML = 'Show Less <i class="fa-solid fa-chevron-up"></i>'
			btn.setAttribute("aria-expanded", "true")
		}
	}

	// FIX: New toggle for the Disclaimer Block
	window.toggleContent = function (btn) {
		const container = btn.closest(".disclaimer-cl")
		const content = container.querySelector(".content1")
		if (!content) return

		const isVisible = window.getComputedStyle(content).display === "block"

		if (isVisible) {
			// Collapse
			content.style.display = "none"
			btn.innerHTML = 'Show More <i class="fa-solid fa-chevron-down"></i>'
		} else {
			// Expand
			content.style.display = "block"
			btn.innerHTML = 'Show Less <i class="fa-solid fa-chevron-up"></i>'
		}
	}
</script>

<script>
	function initSharePopup() {
		const btn = document.getElementById("shareToggleBtn")
		const popup = document.getElementById("sharePopup")
		if (!btn || !popup || btn.dataset.bound === "true") return
		btn.dataset.bound = "true"

		// Build real share-intent URLs pointing at the CURRENT page, not the site's socials
		const pageUrl = encodeURIComponent(window.location.href)
		const pageTitle = encodeURIComponent(document.title)

		const shareLinks = {
			facebook: `https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`,
			x: `https://twitter.com/intent/tweet?url=${pageUrl}&text=${pageTitle}`,
			whatsapp: `https://api.whatsapp.com/send?text=${pageTitle}%20${pageUrl}`,
			reddit: `https://www.reddit.com/submit?url=${pageUrl}&title=${pageTitle}`,
			pinterest: `https://pinterest.com/pin/create/button/?url=${pageUrl}&description=${pageTitle}`,
		}

		popup.querySelectorAll("[data-share]").forEach(link => {
			const key = link.getAttribute("data-share")
			if (shareLinks[key]) link.href = shareLinks[key]
		})

		btn.addEventListener("click", e => {
			e.stopPropagation()
			const isHidden = popup.hasAttribute("hidden")
			if (isHidden) {
				popup.removeAttribute("hidden")
				btn.setAttribute("aria-expanded", "true")
			} else {
				popup.setAttribute("hidden", "")
				btn.setAttribute("aria-expanded", "false")
			}
		})

		document.addEventListener("click", e => {
			if (!popup.contains(e.target) && e.target !== btn) {
				popup.setAttribute("hidden", "")
				btn.setAttribute("aria-expanded", "false")
			}
		})
	}

	if (document.readyState !== "loading") {
		initSharePopup()
	} else {
		document.addEventListener("DOMContentLoaded", initSharePopup)
	}
	document.addEventListener("astro:page-load", initSharePopup)
</script>
