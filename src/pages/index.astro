	/* Darken icon when hovered */
	.cus-tooltip-container:hover .cus-info-icon {
		color: #3b82f6; /* Nice blue highlight on hover */
	}

	/* The actual text box (hidden by default) */
	.cus-tooltip-content {
		position: absolute;
		top: 100%;
		left: 0; /* Aligns the box with the left side of the icon */
		margin-top: 12px;
		width: max-content;
		max-width: 450px; /* Prevents the text from getting too wide */
		background-color: #ffffff;
		color: #475569;
		font-size: 0.85rem;
		line-height: 1.6;
		padding: 16px;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		box-shadow:
			0 10px 15px -3px rgba(0, 0, 0, 0.1),
			0 4px 6px -2px rgba(0, 0, 0, 0.05);

		/* Animation defaults */
		opacity: 0;
		visibility: hidden;
		transform: translateY(-5px);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease,
			visibility 0.3s ease;
		z-index: 100; /* Keeps it above your casino cards */
	}

	/* The little triangle pointing up to the icon */
	.cus-tooltip-content::before {
		content: "";
		position: absolute;
		top: -6px;
		left: 6px; /* Adjust this to center the arrow under the icon */
		width: 10px;
		height: 10px;
		background-color: #ffffff;
		border-top: 1px solid #e2e8f0;
		border-left: 1px solid #e2e8f0;
		transform: rotate(45deg);
	}

	/* Show the tooltip on hover */
	.cus-tooltip-container:hover .cus-tooltip-content {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	/* Mobile responsiveness so it doesn't break the screen width */
	@media (max-width: 600px) {
		.cus-tooltip-content {
			max-width: 300px;
			/* If the icon is on the far right of the screen, you may need to change left: 0 to right: 0 */
		}
