	/* Toggle Button Styling */
	.faq-question {
		width: 100%;
		text-align: left;
		background: none;
		border: none;
		padding: 1.25rem 0;
		font-size: 1.1rem;
		font-weight: 600;
		color: #1e293b;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		transition: color 0.2s ease;
	}

	.faq-question:hover {
		color: #3b82f6; /* Blue hover effect */
	}

	/* Chevron Icon Animation */
	.faq-question i {
		transition: transform 0.3s ease;
		color: #64748b;
	}

	.faq-question[aria-expanded="true"] i {
		transform: rotate(180deg);
	}

	/* Answer Sliding Animation (Using CSS Grid) */
	.faq-answer {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.3s ease-out;
	}

	/* When the parent faq-item has the 'active' class, expand the answer */
	.faq-item.active .faq-answer {
		grid-template-rows: 1fr;
	}

	.faq-answer-inner {
		overflow: hidden;
	}

	/* Spacing inside the answer */
	.faq-answer-inner p {
		margin-top: 0;
		margin-bottom: 1.25rem;
		color: #475569;
		line-height: 1.6;
	}

