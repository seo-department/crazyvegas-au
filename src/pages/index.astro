	/* =========================================
       MODERN HERO CTA CARD (Right Column)
    ========================================= */
	.hero-cta-card {
		position: relative;
		background: linear-gradient(
			145deg,
			rgba(30, 41, 59, 0.8),
			rgba(15, 23, 42, 0.95)
		);
		border: 1px solid #2b4033;
		border-radius: 24px;
		padding: 3rem 2rem 2.5rem; /* Extra top padding to make room for gift icon */
		text-align: center;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
		max-width: 360px;
		margin: 0 auto;
		backdrop-filter: blur(10px);
	}

	/* Overlapping Shaking Gift Icon */
	.gift-icon-wrapper {
		position: absolute;
		top: -30px;
		left: 50%;
		transform: translateX(-50%);
		background: #eab308; /* Vivid Gold/Yellow */
		color: #000000;
		width: 65px;
		height: 65px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.8rem;
		box-shadow: 0 10px 25px rgba(234, 179, 8, 0.4);
		border: 4px solid #050505; /* Matches hero background to look punched-out */
		z-index: 10;
	}

	.shake-icon {
		animation: quickShake 2.5s infinite cubic-bezier(0.36, 0.07, 0.19, 0.97)
			both;
	}

	@keyframes quickShake {
		0%,
		100% {
			transform: translateX(-50%) rotate(0deg);
		}
		10%,
		30%,
		50%,
		70%,
		90% {
			transform: translateX(-50%) rotate(-10deg);
		}
		20%,
		40%,
		60%,
		80% {
			transform: translateX(-50%) rotate(10deg);
		}
	}

	/* Floating/Shaking Mascot Image inside Card */
	.hero-mascot-img.float-shake-img {
		max-width: 180px;
		height: auto;
		margin: 0 auto 1.5rem auto;
		filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.4));
		animation: floatShake 5s ease-in-out infinite;
	}

	@keyframes floatShake {
		0%,
		100% {
			transform: translateY(0) rotate(0deg);
		}
		25% {
			transform: translateY(-10px) rotate(-3deg);
		}
		75% {
			transform: translateY(-10px) rotate(3deg);
		}
	}

