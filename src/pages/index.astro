---
import Layout from "../layouts/Layout.astro"

// =====================================================================
// CONFIG — mapped to your real WordPress categories:
//   casino-recommendations, blog (News), no-deposit, player-guides, promos
//
// "qa" and "execProfiles" are left blank on purpose — there's no matching
// category on this site yet, so those two sections auto-hide (see the
// `.length > 0` guards in the markup below). Create matching categories
// in WP and drop the slug in here whenever you're ready to turn them on.
// =====================================================================
const CATEGORY_SLUGS = {
	inDepth: "casino-recommendations",
	guides: "player-guides",
	qa: "",
	execProfiles: "",
}

// Two more real categories you have that aren't wired to a section yet.
// Not used below — kept here so it's obvious what's available if you
// want a "No Deposit Offers" or "Promos" section added later.
const UNUSED_CATEGORY_SLUGS = {
	noDeposit: "no-deposit",
	promos: "promos",
}

const APP_ID = "6467266"
const wpDomain = `https://wordpress-1164434-${APP_ID}.cloudwaysapps.com`
const wpUrl = `${wpDomain}/graphql`
const LIVE_DOMAIN = "https://au.crazyvegas.com"

const safeHeaders = {
	"Content-Type": "application/json",
	"User-Agent":
		"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
}

// Strip every Cloudways host variant -> root-relative path
function stripWp(input = "") {
	const hosts = [
		wpDomain,
		wpDomain.replace("https://", "http://"),
		wpDomain.replace("https://", "https://www."),
		wpDomain.replace("https://", "http://www."),
	]
	let out = input
	for (const h of hosts) out = out.split(h).join("")
	return out
}

function toRelativeMediaUrl(url: string | undefined | null): string {
	if (!url) return ""
	if (!/\.cloudwaysapps\.com/i.test(url)) return url
	try {
		return new URL(url).pathname
	} catch {
		return stripWp(url)
	}
}

async function gql(query: string, variables: Record<string, any> = {}) {
	const res = await fetch(wpUrl, {
		method: "POST",
		headers: safeHeaders,
		body: JSON.stringify({ query, variables }),
	})

	const contentType = res.headers.get("content-type")
	if (!res.ok || !contentType || !contentType.includes("application/json")) {
		console.error("❌ Cloudways blocked a GraphQL request.")
		return null
	}

	const result = await res.json()
	if (result.errors) {
		console.warn("⚠️ GraphQL error:", result.errors[0]?.message)
		return null
	}
	return result.data
}

// Standard fields every card on this page needs
const POST_FIELDS = `
	uri
	title
	excerpt
	date
	commentCount
	featuredImage { node { sourceUrl altText } }
	categories { nodes { name slug } }
	author {
		node {
			name
			firstName
			lastName
			avatar { url }
		}
	}
`

async function fetchPostsByCategory(slug: string, first = 12) {
	if (!slug) return []
	const data = await gql(
		`
		query GetPostsByCategory($slug: String!, $first: Int!) {
			posts(first: $first, where: { categoryName: $slug }) {
				nodes { ${POST_FIELDS} }
			}
		}
	`,
		{ slug, first },
	)
	return data?.posts?.nodes || []
}

async function fetchLatestPosts(first = 30) {
	const data = await gql(`
		query GetLatestPosts {
			posts(first: ${first}) {
				nodes { ${POST_FIELDS} }
			}
		}
	`)
	return data?.posts?.nodes || []
}

async function fetchCategories() {
	const data = await gql(`
		query GetCategories {
			categories(first: 20, where: { hideEmpty: true }) {
				nodes { name slug count }
			}
		}
	`)
	const nodes = data?.categories?.nodes || []
	return nodes.filter(
		(c: any) => c.name?.toLowerCase() !== "uncategorized" && c.count > 0,
	)
}

async function fetchTeamUsers(first = 8) {
	const data = await gql(`
		query GetUsers {
			users(first: ${first}) {
				nodes {
					name
					slug
					description
					avatar { url }
					roles { nodes { name } }
				}
			}
		}
	`)
	const nodes = data?.users?.nodes || []
	// 🔒 WPGraphQL often restricts the `roles` field for unauthenticated
	// requests, returning an empty roles list even for real admins/authors.
	// If roles come back empty, we assume the user is legit rather than
	// silently filtering out your whole team — we only exclude someone if
	// we can positively confirm they're a subscriber.
	return nodes.filter((u: any) => {
		const roles = (u.roles?.nodes || []).map((r: any) =>
			r.name?.toLowerCase(),
		)
		if (roles.length === 0) return true
		return !roles.includes("subscriber")
	})
}

// Known real photos + on-site titles for specific authors, keyed by their
// WP username/slug (lowercase). Falls back to WP's own avatar + a generic
// title for anyone not listed here — add new authors here as needed.
const TEAM_OVERRIDES: Record<string, { avatar?: string; role: string }> = {
	caleb: {
		avatar: "/wp-content/uploads/2026/03/caleb-daly.png",
		role: "Casino Expert",
	},
	daphne: {
		avatar: "/wp-content/uploads/2026/03/daphne-hutchens.png",
		role: "Editorial Lead",
	},
	kayla: {
		avatar: "/wp-content/uploads/2026/03/kayla-mcbrien.png",
		role: "Senior Casino Analyst",
	},
	mason: {
		avatar: "/wp-content/uploads/2026/03/mason-j.png",
		role: "iGaming Specialist",
	},
	casey: { role: "Contributor" },
	joseph: { role: "Contributor" },
}

// --- Small shared helpers for turning WP data into safe display data ---
function relLink(uri: string | undefined | null) {
	if (!uri) return "/"
	const clean = stripWp(uri).replace(/^\/|\/$/g, "")
	return `/${clean}/`
}

function relImage(url: string | undefined | null, fallback = "") {
	if (!url) return fallback
	try {
		return new URL(url).pathname
	} catch {
		return stripWp(url)
	}
}

function authorNameOf(post: any) {
	const a = post?.author?.node
	if (!a) return "Editorial Team"
	return a.firstName && a.lastName ? `${a.firstName} ${a.lastName}` : a.name
}

function authorAvatarOf(post: any) {
	const a = post?.author?.node
	const raw = a?.avatar?.url
	return relImage(
		raw,
		`https://ui-avatars.com/api/?name=${encodeURIComponent(authorNameOf(post))}&background=f1f5f9&color=1e293b&bold=true`,
	)
}

function fmtDate(dateStr: string) {
	try {
		return new Date(dateStr).toLocaleDateString("en-US", {
			year: "numeric",
			month: "short",
			day: "numeric",
		})
	} catch {
		return ""
	}
}

function primaryCategory(post: any) {
	return post?.categories?.nodes?.[0]?.name || "News"
}

// =====================================================================
// FETCH EVERYTHING — run in parallel to keep build times sane.
// =====================================================================
const [
	homepageSeo,
	latestPosts,
	allCategories,
	inDepthPosts,
	guidesPostsRaw,
	qaPostsRaw,
	execProfiles,
	teamUsers,
] = await Promise.all([
	gql(`
		query GetHomeSeo {
			nodeByUri(uri: "/") {
				... on Page {
					title
					seo { title metaDesc schema { raw } }
				}
			}
		}
	`),
	fetchLatestPosts(30),
	fetchCategories(),
	fetchPostsByCategory(CATEGORY_SLUGS.inDepth, 4),
	fetchPostsByCategory(CATEGORY_SLUGS.guides, 12),
	fetchPostsByCategory(CATEGORY_SLUGS.qa, 20),
	fetchPostsByCategory(CATEGORY_SLUGS.execProfiles, 8),
	fetchTeamUsers(8),
])

const currentYear = new Date().getFullYear().toString()
const pageNode = homepageSeo?.nodeByUri

// 🔒 Hardcoded per request — the homepage title/description are fixed,
// not pulled from Yoast/WP. Schema still comes from WP below.
const yoastTitle = "Crazy Vegas - Top Online Casinos & Pokies Reviewer 2026"
const yoastDesc =
	"Best online casinos & pokies reviews for Australian players. Verified bonuses, honest ratings, and fast-payout picks from the Crazy Vegas team."

let yoastSchema = pageNode?.seo?.schema?.raw || undefined
if (yoastSchema) {
	yoastSchema = yoastSchema.replaceAll(wpDomain, LIVE_DOMAIN)
}

// --- TODAY'S NEWS: hero + 2x2 thumbnail grid (left col) + 3 image-cards (middle col) ---
const newsPosts = latestPosts.slice(0, 8)
const heroStory = newsPosts[0]
const thumbGridStories = newsPosts.slice(1, 5) // 4 items, left column under hero
const midColStories = newsPosts.slice(5, 8) // 3 items, middle column stack

// --- Guarantee filter coverage for every visible pill ---
// The "latest 30 posts overall" pool won't necessarily contain any posts
// from a given category if that category's posts simply aren't among the
// most recently published site-wide — even though the category genuinely
// has posts. So, in addition to the latest posts, pull a handful directly
// FROM each category shown as a pill, and merge everything together
// (de-duped by uri) into one pool the client-side filter can draw from.
const newsPillCategories = allCategories.slice(0, 7)
const pillCategoryPostsRaw = await Promise.all(
	newsPillCategories.map((cat: any) => fetchPostsByCategory(cat.slug, 8)),
)
const newsFilterSourceMap = new Map<string, any>()
for (const p of [...latestPosts, ...pillCategoryPostsRaw.flat()]) {
	if (p?.uri) newsFilterSourceMap.set(p.uri, p)
}
const newsFilterSourcePosts = Array.from(newsFilterSourceMap.values())

// --- Serialized pool for client-side category filtering ---
// The pill filter needs to rebuild ALL THREE news columns together (hero +
// thumbnail grid + middle column) from whichever posts match the selected
// category — not just hide/show the posts that happened to be picked for
// the "All News" view. Otherwise picking a category with none of those
// exact 8 posts leaves a column looking broken/empty even when matching
// posts exist elsewhere in the pool.
const newsFilterPool = newsFilterSourcePosts.map((p: any) => ({
	uri: relLink(p.uri),
	title: p.title || "",
	excerpt: stripWp(p.excerpt || ""),
	image: relImage(p.featuredImage?.node?.sourceUrl),
	imageAlt: p.featuredImage?.node?.altText || p.title || "",
	date: fmtDate(p.date),
	category: primaryCategory(p),
	categories: (p.categories?.nodes || []).map((c: any) => c.slug),
}))
// Escape "<" so this can't break out of the <script type="application/json">
// tag it's embedded in, regardless of what WP content contains.
const newsFilterPoolJson = JSON.stringify(newsFilterPool).replace(
	/</g,
	"\\u003c",
)

// --- MOST POPULAR: same pool, ranked by comment count (client-computed at build time) ---
const mostPopular = [...latestPosts]
	.sort((a, b) => (b.commentCount || 0) - (a.commentCount || 0))
	.slice(0, 6)

// --- MORE NEWS: next batch after the ones already used above, so nothing repeats ---
const usedUris = new Set(
	[...newsPosts, ...mostPopular].map((p: any) => p.uri),
)
const moreNews = latestPosts.filter((p: any) => !usedUris.has(p.uri)).slice(0, 6)

// --- GUIDES: one fetch, three client-toggled sort orders baked in as JSON ---
const guidesNewest = [...guidesPostsRaw].sort(
	(a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
)
const guidesPopular = [...guidesPostsRaw].sort(
	(a, b) => (b.commentCount || 0) - (a.commentCount || 0),
)
const guidesTopPicks = guidesPostsRaw.filter((p: any) =>
	p.categories?.nodes?.some((c: any) => c.slug === "top-picks"),
)
const guidesTopPicksFinal = guidesTopPicks.length ? guidesTopPicks : guidesNewest

// --- Q&As: category pills built from whatever sub-categories exist on qa posts ---
const qaSubCategories = Array.from(
	new Map(
		qaPostsRaw
			.flatMap((p: any) => p.categories?.nodes || [])
			.filter((c: any) => c.slug !== CATEGORY_SLUGS.qa)
			.map((c: any) => [c.slug, c]),
	).values(),
)
---

<Layout
	title={yoastTitle}
	seoTitle={yoastTitle}
	description={yoastDesc}
	schema={yoastSchema}
>
	<main class="hp-main">
		<!-- ================= TODAY'S NEWS ================= -->
		{
			newsPosts.length > 0 && (
				<section class="hp-section" aria-label="Today's news">
					<div class="hp-container">
						<div class="hp-section-header">
							<span class="hp-eyebrow">Today's News</span>
							<a href="/news/" class="hp-more-link">
								More <i class="fa-solid fa-arrow-right" />
							</a>
						</div>

						<div class="hp-news-pills" id="newsPills">
							<button
								class="hp-pill hp-pill-active"
								data-filter="all"
							>
								All News
							</button>
							{allCategories.slice(0, 7).map((cat: any) => (
								<button
									class="hp-pill"
									data-filter={cat.slug}
								>
									{cat.name}
								</button>
							))}
						</div>

						<div class="hp-news-grid">
							<!-- LEFT COLUMN: hero card + 2x2 thumbnail grid -->
							<div class="hp-news-left">
								<div id="newsHeroSlot">
									{heroStory && (
										<a
											href={relLink(heroStory.uri)}
											class="hp-hero-card"
										>
											<div class="hp-hero-image">
												<img
													src={relImage(
														heroStory.featuredImage
															?.node?.sourceUrl,
													)}
													alt={heroStory.featuredImage
														?.node?.altText ||
														heroStory.title}
													referrerpolicy="no-referrer"
												/>
												<span class="hp-hero-badge">
													Breaking
												</span>
											</div>
											<div class="hp-hero-content">
												<h2 set:html={heroStory.title} />
												<span class="hp-hero-cat">
													{primaryCategory(heroStory)}
												</span>
												<p
													class="hp-hero-excerpt"
													set:html={stripWp(
														heroStory.excerpt || "",
													)}
												/>
											</div>
										</a>
									)}
								</div>

								<div class="hp-thumb-grid" id="newsThumbSlot">
									{thumbGridStories.map((story: any) => (
										<a
											href={relLink(story.uri)}
											class="hp-thumb-item"
										>
											<div class="hp-thumb-image">
												<img
													src={relImage(
														story.featuredImage
															?.node?.sourceUrl,
													)}
													alt={story.featuredImage
														?.node?.altText ||
														story.title}
													referrerpolicy="no-referrer"
												/>
											</div>
											<div class="hp-thumb-content">
												<h3 set:html={story.title} />
												<span class="hp-thumb-cat">
													{primaryCategory(story)}
												</span>
											</div>
										</a>
									))}
								</div>
							</div>

							<!-- MIDDLE COLUMN: stacked image-top cards -->
							<div class="hp-mid-col" id="newsMidSlot">
								{midColStories.map((story: any) => (
									<a
										href={relLink(story.uri)}
										class="hp-mid-card"
									>
										<div class="hp-mid-image">
											<img
												src={relImage(
													story.featuredImage?.node
														?.sourceUrl,
												)}
												alt={story.featuredImage?.node
													?.altText || story.title}
												referrerpolicy="no-referrer"
											/>
										</div>
										<h3 set:html={story.title} />
										<span class="hp-mid-cat">
											{primaryCategory(story)}
										</span>
										<span class="hp-mid-date">
											{fmtDate(story.date)}
										</span>
									</a>
								))}
							</div>

							<!-- RIGHT COLUMN: Most Popular plain list (unaffected by the filter) -->
							<aside class="hp-news-sidebar">
								<h3 class="hp-sidebar-title">
									Most Popular
								</h3>
								<div class="hp-popular-list">
									{mostPopular.map((story: any) => (
										<a
											href={relLink(story.uri)}
											class="hp-popular-item"
										>
											<h4 set:html={story.title} />
											<span class="hp-popular-cat">
												{primaryCategory(story)}
											</span>
										</a>
									))}
								</div>
							</aside>
						</div>

						<p class="hp-news-empty" id="newsEmptyState" hidden>
							No stories in this category yet — check back soon.
						</p>
					</div>

					<script
						type="application/json"
						id="newsFilterData"
						set:html={newsFilterPoolJson}
					/>
				</section>
			)
		}

		<!-- ================= IN-DEPTH ================= -->
		{
			inDepthPosts.length > 0 && (
				<section class="hp-section" aria-label="In-depth features">
					<div class="hp-container">
						<div class="hp-section-header">
							<span class="hp-eyebrow">In-Depth</span>
							<a href={`/category/${CATEGORY_SLUGS.inDepth}/`} class="hp-more-link">
								More <i class="fa-solid fa-arrow-right" />
							</a>
						</div>
						<div class="hp-indepth-grid">
							{inDepthPosts.map((post: any) => (
								<a
									href={relLink(post.uri)}
									class="hp-indepth-card"
								>
									<div class="hp-indepth-image">
										<img
											src={relImage(
												post.featuredImage?.node
													?.sourceUrl,
											)}
											alt={post.featuredImage?.node
												?.altText || post.title}
											referrerpolicy="no-referrer"
										/>
									</div>
									<h3 set:html={post.title} />
									<span class="hp-indepth-cat">
										{primaryCategory(post)}
									</span>
								</a>
							))}
						</div>
					</div>
				</section>
			)
		}

		<!-- ================= PROMO BANNER 1 ================= -->
		<section class="hp-promo-banner">
			<div class="hp-container hp-promo-inner">
				<p>
					<svg class="hp-laurel hp-laurel-left" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M12 22c0-6 3-9 8-11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
						<path d="M12 3c1 3 0 5-2 6M12 7c1 3 0 5-2 6M12 11c1 3 0 5-2 6M12 15c1 3 0 5-2 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
					</svg>
					<strong class="hp-promo-highlight">$5m+</strong> in bonuses claimed by
					<strong class="hp-promo-highlight">200K+</strong> monthly readers – and counting.
					<svg class="hp-laurel hp-laurel-right" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M12 22c0-6-3-9-8-11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
						<path d="M12 3c-1 3 0 5 2 6M12 7c-1 3 0 5 2 6M12 11c-1 3 0 5 2 6M12 15c-1 3 0 5 2 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
					</svg>
				</p>
				<a href="/casino-bonuses/" class="hp-promo-btn">
					Claim Bonus <i class="fa-solid fa-arrow-right" />
				</a>
			</div>
		</section>

		<!-- ================= GUIDES ================= -->
		{
			guidesPostsRaw.length > 0 && (
				<section class="hp-section" aria-label="Casino guides">
					<div class="hp-container">
						<div class="hp-section-header">
							<span class="hp-eyebrow">Guides</span>
							<a href={`/category/${CATEGORY_SLUGS.guides}/`} class="hp-more-link">
								More <i class="fa-solid fa-arrow-right" />
							</a>
						</div>

						<div class="hp-guides-tabs">
							<button
								class="hp-tab hp-tab-active"
								data-tab="top"
							>
								Top Picks
							</button>
							<button class="hp-tab" data-tab="popular">
								Most Popular
							</button>
							<button class="hp-tab" data-tab="newest">
								Newest
							</button>
						</div>

						<div class="hp-carousel-wrap">
							<button
								class="hp-carousel-arrow hp-carousel-left"
								id="guidesLeft"
								aria-label="Scroll left"
							>
								<i class="fa-solid fa-chevron-left" />
							</button>

							<div class="hp-carousel" id="guidesCarousel">
								{["top", "popular", "newest"].map(
									(tab, tabIndex) => {
										const list =
											tab === "top"
												? guidesTopPicksFinal
												: tab === "popular"
													? guidesPopular
													: guidesNewest
										return (
											<div
												class="hp-carousel-track"
												data-tab-panel={tab}
												style={
													tabIndex === 0
														? ""
														: "display:none;"
												}
											>
												{list.map((guide: any) => (
													<a
														href={relLink(
															guide.uri,
														)}
														class="hp-guide-card"
													>
														<div class="hp-guide-image">
															<img
																src={relImage(
																	guide
																		.featuredImage
																		?.node
																		?.sourceUrl,
																)}
																alt={
																	guide
																		.featuredImage
																		?.node
																		?.altText ||
																	guide.title
																}
																referrerpolicy="no-referrer"
															/>
														</div>
														<div class="hp-guide-content">
															<span class="hp-guide-cat">
																{primaryCategory(
																	guide,
																)}
															</span>
															<h3
																set:html={
																	guide.title
																}
															/>
															<div class="hp-guide-meta">
																<img
																	src={authorAvatarOf(
																		guide,
																	)}
																	alt={authorNameOf(
																		guide,
																	)}
																/>
																<span>
																	{authorNameOf(
																		guide,
																	)}
																</span>
															</div>
														</div>
													</a>
												))}
											</div>
										)
									},
								)}
							</div>

							<button
								class="hp-carousel-arrow hp-carousel-right"
								id="guidesRight"
								aria-label="Scroll right"
							>
								<i class="fa-solid fa-chevron-right" />
							</button>
						</div>
					</div>
				</section>
			)
		}

		<!-- ================= Q&As ================= -->
		{
			qaPostsRaw.length > 0 && (
				<section class="hp-section hp-section-muted" aria-label="Player Q and A">
					<div class="hp-container">
						<div class="hp-section-header">
							<span class="hp-eyebrow">Q&amp;As</span>
							<p class="hp-section-sub">
