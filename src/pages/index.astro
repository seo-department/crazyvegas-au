---
import Layout from "../layouts/Layout.astro"

// 🔒 Moved to the top so it's available everywhere below (authorBio uses it
// early in the file). Previously this was declared near the bottom, which
// caused "Cannot access 'WP_HOSTS' before initialization".
const WP_HOSTS = [
	"https://wordpress-1164434-6467266.cloudwaysapps.com",
	"http://wordpress-1164434-6467266.cloudwaysapps.com",
	"https://www.wordpress-1164434-6467266.cloudwaysapps.com",
	"http://www.wordpress-1164434-6467266.cloudwaysapps.com",
	"//wordpress-1164434-6467266.cloudwaysapps.com",
]

// Strip the origin host from any string (HTML, JSON-LD, a single URL).
// Leaves a root-relative path: https://wp-host/wp-content/x.png -> /wp-content/x.png
function stripWp(input = "") {
	let out = input
	for (const h of WP_HOSTS) out = out.split(h).join("")
	return out
}

// 1. Fetch BOTH the Homepage content AND the 8 recent posts in a single GraphQL query
const wpUrl = "https://wordpress-1164434-6467266.cloudwaysapps.com/graphql"

// Fetch the full Yoast @graph by extracting it from the rendered WP HTML.
async function fetchYoastGraphFromHtml(pageUrl: string) {
	try {
		const res = await fetch(pageUrl, {
			headers: { "User-Agent": "Mozilla/5.0 AstroBuild" },
		})
		if (!res.ok) return undefined
		const html = await res.text()

		const re =
			/<script[^>]*type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi
		const nodes: any[] = []
		let m: RegExpExecArray | null

		while ((m = re.exec(html)) !== null) {
			try {
				const parsed = JSON.parse(m[1].trim())
				if (parsed["@graph"] && Array.isArray(parsed["@graph"])) {
					// Yoast-style: flatten the @graph array into our combined nodes
					nodes.push(...parsed["@graph"])
				} else if (Array.isArray(parsed)) {
					nodes.push(...parsed)
				} else {
					nodes.push(parsed)
				}
			} catch (err) {
				// Skip malformed blocks silently
			}
		}

		if (!nodes.length) return undefined

		// De-duplicate by @id (Yoast entries all have @id anchors)
		const seen = new Set<string>()
		const deduped = nodes.filter(n => {
			const id = n["@id"]
			if (!id) return true
			if (seen.has(id)) return false
			seen.add(id)
			return true
		})

		return JSON.stringify({
			"@context": "https://schema.org",
			"@graph": deduped,
		})
	} catch (e: any) {
		console.error("❌ Failed to fetch Yoast schema:", e.message)
		return undefined
	}
}

const response = await fetch(wpUrl, {
	method: "POST",
	headers: { "Content-Type": "application/json" },
	body: JSON.stringify({
		query: `
            query GetHomeAndPosts {
                nodeByUri(uri: "/") {
                    ... on Page {
                        title
                        content
                        date
                        modified
                        seo {
                            title metaDesc focuskw canonical metaRobotsNoindex metaRobotsNofollow
                        }
                        author {
                            node {
                                databaseId
                                name
                                firstName
                                lastName
                                description
                                url
                                avatar { url width height }
                                seo { social { facebook twitter instagram linkedIn } }
                            }
                        }
                    }
                }
                posts(first: 8) {
                    nodes {
                        uri
                        title
                        excerpt
                        date
                        featuredImage {
                            node {
                                sourceUrl
                                altText
                            }
                        }
                        author {
                            node {
                                name
                                firstName
                                lastName
                                avatar { url }
                            }
                        }
                    }
                }
            }
        `,
	}),
})

const result = await response.json()

if (result.errors) {
	console.error("❌ GRAPHQL ERROR:", JSON.stringify(result.errors, null, 2))
	throw new Error("WordPress rejected the GraphQL query.")
}

// --- 2. PROCESS HOMEPAGE DATA ---
const page = result.data?.nodeByUri
const currentYear = new Date().getFullYear().toString()
const yoastTitle = (page?.seo?.title || page?.title || "Casino US").replaceAll(
	"[year]",
	currentYear,
)
const yoastDesc = (page?.seo?.metaDesc || "").replaceAll("[year]", currentYear)

// 🚨 FIX: Updated to match your new Cloudways App URL
const wpDomain = "https://wordpress-1164434-6467266.cloudwaysapps.com"

// Fetch the full Yoast @graph directly from the rendered WP HTML (bypass GraphQL).
let yoastSchema = await fetchYoastGraphFromHtml(wpDomain + "/")
if (yoastSchema) {
	yoastSchema = yoastSchema
		.replaceAll(
			"https://www.wordpress-1164434-6467266.cloudwaysapps.com",
			"https://au.crazyvegas.com",
		)
		.replaceAll(
			"http://www.wordpress-1164434-6467266.cloudwaysapps.com",
			"https://au.crazyvegas.com",
		)
		.replaceAll(
			"https://wordpress-1164434-6467266.cloudwaysapps.com",
			"https://au.crazyvegas.com",
		)
		.replaceAll(
			"http://wordpress-1164434-6467266.cloudwaysapps.com",
			"https://au.crazyvegas.com",
		)
		// 🚨 Catch bare-domain leaks (e.g. inside email addresses) that have no protocol prefix
		.replace(
			/([a-zA-Z0-9._%+-]+)@wordpress-1164434-6467266\.cloudwaysapps\.com/g,
			"contact@au.crazyvegas.com",
		)
		.replaceAll("[year]", currentYear)
}

// Hero Meta Data (Author)
const authorObj = page?.author?.node
const authorName = authorObj
	? authorObj.firstName && authorObj.lastName
		? `${authorObj.firstName} ${authorObj.lastName}`
		: authorObj.name
	: "Editorial Team"

// Strip HTML tags from WP bio text — descriptions sometimes contain markup
// like <strong>Name</strong>, which would otherwise render as literal text
// in the plain-text tooltip instead of being interpreted as formatting.
const stripHtmlTags = (html: string) => {
	if (!html) return ""
	return html.replace(/<\/?[^>]+(>|$)/g, "").trim()
}

// 🚨 NEW: Hover-tooltip bio text for author & reviewer name links
const authorBio = authorObj?.description
	? stripHtmlTags(stripWp(authorObj.description))
	: `${authorName} is part of our editorial team, contributing casino guides, news, and reviews.`

// Caleb Daly is currently hardcoded as the site-wide reviewer, so his bio
// is hardcoded too — swap this out if/when reviewer data comes from WP.
const reviewerBio =
	"Caleb Daly is a dynamic iGaming professional and investigative journalist with a unique blend of operational casino experience and media-savvy storytelling. Formerly a casino manager, he brings an insider’s perspective to every article - from regulatory deep-dives to review breakdowns and news features. With his dual background in casino operations and journalism, Caleb ensures readers receive accurate, comprehensive, and trustworthy information about the evolving online gambling landscape in Australia."

if (yoastSchema && authorName) {
	const escapedName = authorName.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
	const dupeNamePattern = new RegExp(
		`("description"\\s*:\\s*"\\s*)${escapedName}\\s+${escapedName}\\b`,
		"g",
	)
	yoastSchema = yoastSchema.replace(dupeNamePattern, `$1${authorName}`)
}

let authorAvatar =
	authorObj?.avatar?.url ||
	`https://ui-avatars.com/api/?name=${encodeURIComponent(authorName)}&background=f1f5f9&color=1e293b&bold=true`
const authorSlug = authorName
	.toLowerCase()
	.replace(/[^a-z0-9]+/g, "-")
	.replace(/(^-|-$)+/g, "")
const authorLink = `/about-us/${authorSlug}/`

// Author Social Links
const authorSocials = authorObj?.seo?.social || {}
const formatSocial = (value: string | undefined, domain: string) => {
	if (!value) return null
	return value.startsWith("http")
		? value
		: `${domain}${value.replace(/^@/, "")}`
}
const authorTwitter = formatSocial(
	authorSocials.twitter,
	"https://twitter.com/",
)
const authorFacebook = formatSocial(
	authorSocials.facebook,
	"https://facebook.com/",
)
const authorInstagram = formatSocial(
	authorSocials.instagram,
	"https://instagram.com/",
)
const authorLinkedIn = formatSocial(
	authorSocials.linkedIn,
	"https://linkedin.com/in/",
)

// Build a standalone Person schema from GraphQL author data — independent of Yoast.
let personSchema: string | undefined
if (authorObj) {
	const person: any = {
		"@context": "https://schema.org",
		"@type": "Person",
		"@id": `https://au.crazyvegas.com/#/schema/person/${authorSlug}-profile`,
		name: authorName,
		url: authorObj.url || `https://au.crazyvegas.com${authorLink}`,
	}
	if (authorObj.description) person.description = authorObj.description
	if (authorObj.avatar?.url) {
		person.image = {
			"@type": "ImageObject",
			url: authorObj.avatar.url,
			...(authorObj.avatar.width && { width: authorObj.avatar.width }),
			...(authorObj.avatar.height && { height: authorObj.avatar.height }),
			caption: authorName,
		}
	}
	const sameAs = [
		authorTwitter,
		authorFacebook,
		authorInstagram,
		authorLinkedIn,
	].filter(Boolean)
	if (sameAs.length) person.sameAs = sameAs

	personSchema = JSON.stringify(person)
}

// Reviewer Data
const reviewerName = "Caleb Daly"
const reviewerAvatar = "/wp-content/uploads/2026/03/caleb-daly.png"
const reviewerTwitter: string | null = null // add real handle/URL if Caleb has one, e.g. "https://twitter.com/handle"
const reviewerSlug = reviewerName
	.toLowerCase()
	.replace(/[^a-z0-9]+/g, "-")
	.replace(/(^-|-$)+/g, "")
const reviewerLink = `/about-us/${reviewerSlug}/`

const rawDate = page?.modified || page?.date || new Date().toISOString()
const formattedDate = new Date(rawDate).toLocaleDateString("en-US", {
	year: "numeric",
	month: "short",
	day: "numeric",
})

// Determine once whether Yoast's own graph already has a Person node
let yoastHasPerson = false
if (yoastSchema) {
	try {
		const checkSchema = JSON.parse(yoastSchema)
		const checkGraph = checkSchema["@graph"] || []
		yoastHasPerson = checkGraph.some((n: any) => {
			const t = n["@type"]
			return t === "Person" || (Array.isArray(t) && t.includes("Person"))
		})
	} catch (e) {
		// leave as false on parse failure
	}
}

// 🚨 Build a rich Person node from real GraphQL author data — only if Yoast doesn't already have one.
if (yoastSchema && !yoastHasPerson) {
	try {
		const parsedSchema = JSON.parse(yoastSchema)
		const graph = parsedSchema["@graph"] || []

		const personId = `https://au.crazyvegas.com/#/schema/person/${authorSlug}-profile`
		const person: any = {
			"@type": "Person",
			"@id": personId,
			name: authorName,
			url: authorObj?.url || `https://au.crazyvegas.com${authorLink}`,
			sameAs: [
				authorTwitter,
				authorFacebook,
				authorInstagram,
				authorLinkedIn,
			].filter(Boolean),
		}

		if (authorObj?.description) person.description = authorObj.description

		if (authorObj?.avatar?.url) {
			person.image = {
				"@type": "ImageObject",
				"@id": `https://au.crazyvegas.com/#/schema/person/image/${authorSlug}-profile`,
				url: authorObj.avatar.url,
				contentUrl: authorObj.avatar.url,
				...(authorObj.avatar.width && {
					width: authorObj.avatar.width,
				}),
				...(authorObj.avatar.height && {
					height: authorObj.avatar.height,
				}),
				caption: authorName,
			}
		}

		graph.push(person)
		parsedSchema["@graph"] = graph
		yoastSchema = JSON.stringify(parsedSchema)
	} catch (e) {
		// leave schema as-is on parse failure
	}
}

// Clean the WordPress Content
const rawContent = page?.content || ""
const fixedContent = rawContent
	.replace(/<h1[^>]*>[\s\S]*?<\/h1>/gi, "")
	.replace(/src="[^"]*placeholder[^"]*"/gi, "")
	.replaceAll('data-src="/wp-content/', 'src="/wp-content/')
	.replaceAll('data-srcset="/wp-content/', 'srcset="/wp-content/')

	// 🚨 BULLETPROOF FIX: Globally strip the Cloudways domain from the entire HTML string.
	// This catches internal links (href), main images (src), and all srcset variants.
	.replaceAll(wpDomain, "")

	.replaceAll("<img ", '<img referrerpolicy="no-referrer" ')
	.replace(/<p>\s*(&nbsp;)?\s*<\/p>/gi, "")
	.replace(
		/<strong>\s*Ranking of the Best Payment Methods\s*<\/strong>/gi,
		"",
	)
	.replace(/<p>\s*\[casino_toc\]\s*<\/p>/gi, "")
	.replaceAll("[casino_toc]", "") // Failsafe in case it's not in a <p> tag
	.replaceAll("[year]", currentYear)

	.replace(/(https?:\/\/[^\/"]+)\/\1\//g, "$1/")

	.replace(
		/<a([^>]*?)href="\/play\/([^"]+?)(?:-casino)?"([^>]*?)class="cus-claim-btn"/g,
		(full: string, pre: string, slug: string, mid: string) => {
			const name = slug
				.replace(/-/g, " ")
				.replace(/\b\w/g, (c: string) => c.toUpperCase())
			return `<a${pre}href="/play/${slug}-casino"${mid}class="cus-claim-btn" aria-label="Claim bonus at ${name} Casino"`
		},
	)

	.replace(/<h3([^>]*\bcus-bonus-title\b[^>]*)>/g, "<div$1>")
	.replace(/<\/h3>(?=\s*<\/[^>]*cus-)/g, "</div>")

// --- 3. PROCESS RECENT POSTS (For Breaking News Section) ---
const recentPosts = result.data?.posts?.nodes || []
const breakingStories = recentPosts.slice(0, 3)
const blogPosts = recentPosts.slice(3, 7)
---

