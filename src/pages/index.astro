	}
	.hp-guide-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.hp-guide-meta img {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		object-fit: cover;
	}
	.hp-guide-meta span {
		font-size: 0.78rem;
		color: #64748b;
		font-weight: 600;
	}

	.hp-carousel-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: #0f172a;
		color: #fff;
		border: none;
		cursor: pointer;
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.hp-carousel-left {
		left: -20px;
	}
	.hp-carousel-right {
		right: -20px;
	}

	/* ---------- Q&As ---------- */
	.hp-qa-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}
	.hp-qa-card {
		background: #fff;
		border: 1px solid #e2e8f0;
		border-radius: 12px;
		padding: 1.25rem;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
	}
	.hp-qa-question h4 {
		font-size: 0.98rem;
		font-weight: 700;
		color: #0f172a;
		margin: 0 0 0.4rem 0;
	}
	.hp-qa-excerpt {
		font-size: 0.85rem;
		color: #64748b;
		line-height: 1.5;
	}
	.hp-qa-excerpt p {
		margin: 0;
	}
	.hp-qa-btn {
		flex-shrink: 0;
		background: #f1f5f9;
		color: #2563eb;
		border: 1px solid #dbeafe;
		font-weight: 700;
		font-size: 0.8rem;
		padding: 0.5rem 1rem;
		border-radius: 8px;
		text-decoration: none;
		white-space: nowrap;
	}
	.hp-qa-btn:hover {
		background: #dbeafe;
	}

	/* ---------- Executive Profiles ---------- */
	.hp-exec-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
	}
	.hp-exec-card {
		position: relative;
		display: block;
		border-radius: 12px;
		overflow: hidden;
		height: 200px;
		text-decoration: none;
	}
	.hp-exec-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hp-exec-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgba(0, 0, 0, 0.9) 0%,
			rgba(0, 0, 0, 0) 65%
		);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 1rem;
	}
	.hp-exec-overlay h4 {
		color: #fff;
		font-size: 0.98rem;
		font-weight: 800;
		margin: 0 0 0.2rem 0;
	}
	.hp-exec-overlay span {
		color: #cbd5e1;
		font-size: 0.78rem;
	}
	.hp-exec-overlay span p {
		margin: 0;
	}

	/* ---------- More News ---------- */
	.hp-more-news-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	.hp-more-news-card {
		display: block;
		text-decoration: none;
	}
	.hp-more-news-image {
		border-radius: 10px;
		overflow: hidden;
		height: 160px;
		margin-bottom: 0.75rem;
	}
	.hp-more-news-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hp-more-news-cat {
		color: #dc2626;
		font-size: 0.7rem;
		font-weight: 800;
		text-transform: uppercase;
	}
	.hp-more-news-card h3 {
		font-size: 1rem;
		font-weight: 700;
		color: #0f172a;
		margin: 0.4rem 0;
		line-height: 1.4;
	}
	.hp-more-news-card:hover h3 {
		color: #2563eb;
	}
	.hp-more-news-date {
		font-size: 0.78rem;
		color: #94a3b8;
	}

	/* ---------- About / Team ---------- */
	.hp-team-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
	}
	.hp-team-card {
		display: flex;
		align-items: stretch;
		gap: 1rem;
		text-decoration: none;
		background: #fff;
		border: 1px solid #e2e8f0;
		padding: 1rem;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}
	.hp-team-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 18px -6px rgba(0, 0, 0, 0.1);
		border-color: #cbd5e1;
	}
	.hp-team-photo {
		position: relative;
		flex-shrink: 0;
		width: 84px;
		height: 100px;
	}
	.hp-team-photo::before {
		content: "";
		position: absolute;
		left: -18px;
		bottom: -14px;
		width: 60px;
		height: 60px;
		background: #dc2626;
		transform: rotate(45deg);
		z-index: 0;
	}
	.hp-team-photo img {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1);
	}
	.hp-team-info {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-width: 0;
	}
	.hp-team-info h4 {
		font-size: 1rem;
		font-weight: 800;
		color: #0f172a;
		margin: 0 0 0.4rem 0;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid #cbd5e1;
		line-height: 1.3;
	}
	.hp-team-info span {
		font-size: 0.85rem;
		color: #64748b;
		font-style: italic;
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 1024px) {
		.hp-news-grid {
			grid-template-columns: 1fr;
		}
		.hp-indepth-grid,
		.hp-exec-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.hp-more-news-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.hp-team-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.hp-indepth-grid,
		.hp-exec-grid,
		.hp-more-news-grid,
		.hp-team-grid,
		.hp-qa-grid {
			grid-template-columns: 1fr;
		}
		.hp-hero-content h2 {
			font-size: 1.3rem;
		}
		.hp-carousel-left {
			left: 4px;
		}
		.hp-carousel-right {
			right: 4px;
		}
		.hp-promo-inner p {
			font-size: 1.25rem;
		}
		.hp-laurel {
			width: 20px;
			height: 20px;
		}
	}

	.hp-hero-content p, h2 {
    color: #fff !important;
}

.hp-guide-meta {
    display: none !important;
}

.hp-container.hp-promo-inner p {
    display: block;
}
</style>

<script>
	// ---- Simple pill filter (Q&A grid — safe to just hide/show cards) ----
	function setupSimplePillFilter(pillsId: string, itemsSelector: string) {
		const pillsWrap = document.getElementById(pillsId)
		if (!pillsWrap) return

		pillsWrap.addEventListener("click", e => {
			const btn = (e.target as HTMLElement).closest(
				"[data-filter]",
			) as HTMLElement | null
			if (!btn) return

			pillsWrap
				.querySelectorAll(".hp-pill")
				.forEach(p => p.classList.remove("hp-pill-active"))
			btn.classList.add("hp-pill-active")

			const filter = btn.dataset.filter
			document.querySelectorAll(itemsSelector).forEach(item => {
				const cats = (item as HTMLElement).dataset.categories || ""
				const show = filter === "all" || cats.split(",").includes(filter!)
				;(item as HTMLElement).style.display = show ? "" : "none"
			})
		})
	}

	setupSimplePillFilter("qaPills", "#qaGrid [data-categories]")

	// ---- Today's News: rebuild ALL THREE columns together on pill click ----
	// (Hiding pre-placed cards independently caused empty-looking columns
	// whenever the "All News" 8-post selection didn't include a match for
	// the chosen category — see comment on newsFilterPool in the frontmatter.)
	type NewsItem = {
		uri: string
		title: string
		excerpt: string
		image: string
		imageAlt: string
		date: string
		category: string
		categories: string[]
	}

	function escapeHtml(str: string) {
		return str.replace(
			/[&<>"']/g,
			c =>
				({
					"&": "&amp;",
					"<": "&lt;",
					">": "&gt;",
					'"': "&quot;",
					"'": "&#39;",
				})[c] as string,
		)
	}

	function heroHtml(item: NewsItem) {
		return `
			<a href="${item.uri}" class="hp-hero-card">
				<div class="hp-hero-image">
					<img src="${item.image}" alt="${escapeHtml(item.imageAlt)}" referrerpolicy="no-referrer" />
					<span class="hp-hero-badge">Breaking</span>
				</div>
				<div class="hp-hero-content">
					<h2>${item.title}</h2>
					<span class="hp-hero-cat">${escapeHtml(item.category)}</span>
					<p class="hp-hero-excerpt">${item.excerpt}</p>
				</div>
			</a>
		`
	}

	function thumbHtml(item: NewsItem) {
		return `
			<a href="${item.uri}" class="hp-thumb-item">
				<div class="hp-thumb-image">
					<img src="${item.image}" alt="${escapeHtml(item.imageAlt)}" referrerpolicy="no-referrer" />
				</div>
				<div class="hp-thumb-content">
					<h3>${item.title}</h3>
					<span class="hp-thumb-cat">${escapeHtml(item.category)}</span>
				</div>
			</a>
		`
	}

	function midHtml(item: NewsItem) {
		return `
			<a href="${item.uri}" class="hp-mid-card">
				<div class="hp-mid-image">
					<img src="${item.image}" alt="${escapeHtml(item.imageAlt)}" referrerpolicy="no-referrer" />
				</div>
				<h3>${item.title}</h3>
				<span class="hp-mid-cat">${escapeHtml(item.category)}</span>
				<span class="hp-mid-date">${escapeHtml(item.date)}</span>
			</a>
		`
	}

	function setupNewsFilter() {
		const pillsWrap = document.getElementById("newsPills")
		const dataEl = document.getElementById("newsFilterData")
		const heroSlot = document.getElementById("newsHeroSlot")
		const thumbSlot = document.getElementById("newsThumbSlot")
		const midSlot = document.getElementById("newsMidSlot")
		const emptyState = document.getElementById("newsEmptyState")
		if (!pillsWrap || !dataEl || !heroSlot || !thumbSlot || !midSlot) return

		let pool: NewsItem[] = []
		try {
			pool = JSON.parse(dataEl.textContent || "[]")
		} catch {
			return
		}

		pillsWrap.addEventListener("click", e => {
			const btn = (e.target as HTMLElement).closest(
				"[data-filter]",
			) as HTMLElement | null
			if (!btn) return

			pillsWrap
				.querySelectorAll(".hp-pill")
				.forEach(p => p.classList.remove("hp-pill-active"))
			btn.classList.add("hp-pill-active")

			const filter = btn.dataset.filter
			const matches =
				filter === "all"
					? pool
					: pool.filter(p => p.categories.includes(filter!))

			const hero = matches[0]
			const thumbs = matches.slice(1, 5)
			const mids = matches.slice(5, 8)

			if (matches.length === 0) {
				heroSlot.innerHTML = ""
				thumbSlot.innerHTML = ""
				midSlot.innerHTML = ""
				if (emptyState) emptyState.hidden = false
				return
			}
			if (emptyState) emptyState.hidden = true

			heroSlot.innerHTML = hero ? heroHtml(hero) : ""
			thumbSlot.innerHTML = thumbs.map(thumbHtml).join("")
			midSlot.innerHTML = mids.map(midHtml).join("")
		})
	}

	setupNewsFilter()

	// ---- Guides tab toggle ----
	document.querySelectorAll(".hp-guides-tabs .hp-tab").forEach(tab => {
		tab.addEventListener("click", () => {
			document
				.querySelectorAll(".hp-guides-tabs .hp-tab")
				.forEach(t => t.classList.remove("hp-tab-active"))
			tab.classList.add("hp-tab-active")

			const target = (tab as HTMLElement).dataset.tab
			document.querySelectorAll("[data-tab-panel]").forEach(panel => {
				(panel as HTMLElement).style.display =
					(panel as HTMLElement).dataset.tabPanel === target
						? "flex"
						: "none"
			})
		})
	})

	// ---- Guides carousel arrows ----
	const carousel = document.getElementById("guidesCarousel")
	const leftBtn = document.getElementById("guidesLeft")
	const rightBtn = document.getElementById("guidesRight")

	function activeTrack() {
		return carousel?.querySelector(
			'[data-tab-panel]:not([style*="display: none"])',
		) as HTMLElement | null
	}

	leftBtn?.addEventListener("click", () => {
		activeTrack()?.scrollBy({ left: -300, behavior: "smooth" })
	})
	rightBtn?.addEventListener("click", () => {
		activeTrack()?.scrollBy({ left: 300, behavior: "smooth" })
	})
</script>